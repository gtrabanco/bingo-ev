  const groupForm = $<HTMLFormElement>('#group-form');
  const groupNameInput = $<HTMLInputElement>('#group-name');
  const groupPasswordInput = $<HTMLInputElement>('#group-password');
  const groupPublicCheck = $<HTMLInputElement>('#group-public');
  const groupHint = $<HTMLParagraphElement>('#group-hint');
  const groupCurrentBox = $<HTMLDivElement>('#group-current');
  const groupCreateBox = $<HTMLDivElement>('#group-create');
  const groupLink = $<HTMLAnchorElement>('#group-link');
  const aliasDisplay = $<HTMLParagraphElement>('#alias-display');
  const aliasLabel = $<HTMLElement>('#alias-label');
  const aliasEditButton = $<HTMLButtonElement>('#alias-edit');
  const aliasForm = $<HTMLFormElement>('#alias-form');
  const aliasInput = $<HTMLInputElement>('#alias-input');
