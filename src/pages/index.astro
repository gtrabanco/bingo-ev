---
import Layout from '../layouts/Layout.astro';
import BingoCard from '../components/BingoCard.astro';
import CertificateModal from '../components/CertificateModal.astro';
---

<Layout
  title="El Bingo del Cargador — Juego de bingo online sobre desgracias del cargador EV en España"
  description="Juega gratis al bingo del cargador eléctrico. Marca las desgracias típicas de la recarga pública en España, canta línea y bingo, y consigue tu diploma verificable."
>
  <main class="mx-auto flex min-h-dvh w-full max-w-md flex-col px-4 pt-7 pb-6 sm:max-w-lg sm:pt-12">
    <header class="text-center">
      <p class="text-[0.625rem] font-bold uppercase tracking-[0.4em] text-amber-300/80 sm:text-xs">
        Gran sorteo nacional de la recarga
      </p>
      <h1
        class="mt-2 text-4xl font-black uppercase tracking-tight text-balance text-amber-300 drop-shadow-[0_3px_0_rgb(0_0_0/0.45)] sm:text-5xl"
      >
        El Bingo del Cargador
      </h1>
      <p class="mx-auto mt-3 max-w-sm text-sm/relaxed text-paper-300/90 sm:max-w-md sm:text-base/relaxed">
        <strong>Juego de bingo gratuito</strong> sobre las desgracias típicas del cargador público en España. Seis situaciones por cartón, repartidas al azar. Marca las que vivas: la <strong>línea se canta</strong>, el <strong>bingo se certifica</strong> con diploma verificable, y el cartón caduca en un mes.
      </p>
    </header>

    <section
      class="mt-5 flex items-center justify-between gap-3 rounded-xl border border-paper-50/15 bg-felt-950/40 px-4 py-2.5 text-sm sm:text-base"
      aria-live="polite"
    >
      <p id="status-marks" class="shrink-0 font-bold">0/6 desgracias</p>
      <p id="status-lines" class="text-right text-paper-300/85">Sin líneas. De momento.</p>
    </section>

    <div class="mt-4" id="card-container">
      <BingoCard />
    </div>

    <button
      id="show-cert"
      type="button"
      class="mt-4 hidden w-full rounded-xl bg-amber-300 px-4 py-3 text-sm font-black uppercase tracking-widest text-felt-950 shadow-[0_6px_0_rgb(0_0_0/0.3)] transition-all active:translate-y-0.5 active:shadow-none sm:text-base"
    >
      Tu diploma
    </button>

    <button
      id="show-cert-bad"
      type="button"
      class="mt-4 hidden w-full rounded-xl bg-orange-600 px-4 py-3 text-sm font-black uppercase tracking-widest text-paper-50 shadow-[0_6px_0_rgb(0_0_0/0.3)] transition-all active:translate-y-0.5 active:shadow-none sm:text-base"
    >
      Tu certificado de sinvergüenza
    </button>

    <button
      id="share-card"
      type="button"
      class="mt-4 hidden w-full rounded-xl border-2 border-paper-50/30 px-4 py-2.5 text-xs font-black uppercase tracking-widest transition-colors hover:bg-paper-50/10 active:bg-paper-50/15 sm:text-sm"
    >
      Compartir cómo voy
    </button>

    <noscript>
      <p
        class="mt-4 rounded-xl border border-amber-300/40 bg-amber-300/10 px-4 py-3 text-center text-sm text-amber-200"
      >
        Esto necesita JavaScript activado. Como los cargadores, pero de verdad.
      </p>
    </noscript>

    <div class="mt-auto pt-8">
      <button
        id="new-card"
        type="button"
        class="w-full rounded-xl border-2 border-paper-50/30 px-4 py-3 text-sm font-black uppercase tracking-widest transition-colors hover:bg-paper-50/10 active:bg-paper-50/15 sm:text-base"
      >
        Regenerar cartón
      </button>

      <details class="mt-4 rounded-xl border border-paper-50/15 bg-felt-950/40 px-4 py-3">
        <summary
          class="cursor-pointer list-none text-xs font-bold uppercase tracking-widest text-paper-300/80 sm:text-sm"
        >
          Guarda o recupera tus cartones
        </summary>

        <div class="mt-3">
          <p class="text-[0.6875rem]/relaxed text-paper-300/70 sm:text-xs/relaxed">
            Vincula un correo a este cartón y podrás recuperarlo en otro dispositivo. Sin
            contraseñas: te llegará un enlace al email.
          </p>
          <form id="email-form" class="mt-2 flex flex-col gap-2">
            <input
              id="email-input"
              type="email"
              required
              placeholder="tu@correo.es"
              autocomplete="email"
              class="w-full rounded-lg border-2 border-paper-50/25 bg-felt-950/60 px-3 py-2 text-sm text-paper-50 outline-none placeholder:text-paper-300/40 focus:border-amber-300 sm:text-base"
            />
            <label class="flex items-start gap-2 text-[0.6875rem]/snug text-paper-300/70 sm:text-xs/snug">
              <input id="newsletter-check" type="checkbox" class="mt-0.5 shrink-0" />
              <span>
                Apúntame a la newsletter de
                <a
                  href="https://gtrabanco.com"
                  target="_blank"
                  rel="noopener"
                  class="underline decoration-paper-300/40">Gabriel Trabanco</a
                >. Sin agobios.
              </span>
            </label>
            <button
              id="email-submit"
              type="submit"
              class="rounded-lg bg-amber-300 px-4 py-2 text-xs font-black uppercase tracking-widest text-felt-950 transition-colors active:bg-amber-400 sm:text-sm"
            >
              Vincular este cartón
            </button>
          </form>

          <hr class="my-3 border-paper-50/10" />

          <p class="text-[0.6875rem]/relaxed text-paper-300/70 sm:text-xs/relaxed">
            ¿Ya tenías cartones guardados? Te reenviamos los enlaces.
          </p>
          <form id="recover-form" class="mt-2 flex gap-2">
            <input
              id="recover-input"
              type="email"
              required
              placeholder="tu@correo.es"
              autocomplete="email"
              class="min-w-0 flex-1 rounded-lg border-2 border-paper-50/25 bg-felt-950/60 px-3 py-2 text-sm text-paper-50 outline-none placeholder:text-paper-300/40 focus:border-amber-300 sm:text-base"
            />
            <button
              id="recover-submit"
              type="submit"
              class="shrink-0 rounded-lg border-2 border-paper-50/30 px-4 py-2 text-xs font-black uppercase tracking-widest transition-colors hover:bg-paper-50/10 sm:text-sm"
            >
              Recuperar
            </button>
          </form>
          <p id="email-hint" class="mt-2 min-h-4 text-[0.6875rem]/snug text-amber-200/90 sm:text-xs/snug" aria-live="polite"></p>
        </div>
      </details>

      <a
        href="https://www.tesla.com/es_es/referral/gabriel746720"
        target="_blank"
        rel="noopener"
        class="group mt-6 block rounded-2xl border-2 border-amber-300/60 bg-gradient-to-br from-amber-300/15 to-amber-300/5 px-5 py-4 text-center transition-colors hover:border-amber-300 hover:bg-amber-300/10"
      >
        <p class="text-[0.625rem] font-bold uppercase tracking-[0.3em] text-amber-300/80 sm:text-xs">
          Publicidad descarada
        </p>
        <p class="mt-1.5 text-sm/relaxed text-paper-50 sm:text-base/relaxed">
          ¿Aun con este bingo te pasas al eléctrico? Hazlo con mi
          <strong>referido de Tesla</strong> y ganamos los dos. Sobre todo yo.
        </p>
        <span
          class="mt-3 inline-block rounded-xl bg-amber-300 px-5 py-2.5 text-xs font-black uppercase tracking-widest text-felt-950 shadow-[0_4px_0_rgb(0_0_0/0.3)] transition-all group-hover:shadow-[0_5px_0_rgb(0_0_0/0.3)] group-active:translate-y-0.5 group-active:shadow-none sm:text-sm"
        >
          ⚡ Usar el referido
        </span>
      </a>

      <footer class="pt-6 text-center text-[0.6875rem]/relaxed text-paper-300/55 sm:text-sm/relaxed">
        <p>
          Situaciones 100&nbsp;% genéricas: aquí no se señala a nadie. Cada cual sabrá si se da
          por aludido.
        </p>
        <p class="mt-2 text-[0.625rem] sm:text-xs">
          <strong>Sobre este bingo:</strong> Un juego online gratuito de bingo cartón con 40 desgracias reales del cargador público eléctrico en España. Reglas tradicionales: línea por fila, bingo cuando completas los seis. Diplomas verificables con enlace público.
        </p>
        <p class="mt-1.5 font-semibold">bingo.gruxon.com · Hecho con resignación · 2026</p>
        <p class="mt-2">
          Creado por
          <a
            href="https://gtrabanco.com"
            target="_blank"
            rel="noopener"
            class="underline decoration-paper-300/40 underline-offset-2 transition-colors hover:text-paper-50"
          >Gabriel Trabanco</a>
          ·
          <a
            href="https://github.com/gtrabanco/bingo-ev"
            target="_blank"
            rel="noopener"
            class="underline decoration-paper-300/40 underline-offset-2 transition-colors hover:text-paper-50"
          >Código en GitHub</a>
        </p>
      </footer>
    </div>
  </main>

  <!-- "¡Línea!" toast -->
  <div
    id="toast"
    aria-live="polite"
    class="pointer-events-none fixed inset-x-0 bottom-7 z-50 flex translate-y-3 justify-center opacity-0 transition-all duration-300"
  >
    <p
      id="toast-text"
      class="rounded-full bg-amber-300 px-6 py-2.5 text-center text-sm font-black uppercase tracking-[0.12em] text-felt-950 shadow-xl sm:text-base"
    >
    </p>
  </div>

  <CertificateModal />
</Layout>

<script>
  // Game wiring: render the card, toggle marks, persist, detect wins, enforce
  // the one-month expiry and drive the certificate dialog. Pure logic lives
  // in src/lib/.
  import {
    SITUATION_COUNT,
    expiryDate,
    generateCard,
    getSituation,
    isExpired,
    packMarks,
    type CardState,
  } from '../lib/card';
  import {
    downloadCertificate,
    drawCertificate,
    type CertificateData,
  } from '../lib/certificate';
  import {
    cardShareUrl,
    discardCard,
    fetchOwnedCard,
    linkEmail,
    registerCard,
    reportCompletion,
    requestRecovery,
    syncMarks,
    verificationUrl,
  } from '../lib/api';
  import { echarConfetti } from '../lib/confetti';
  import { loadCurrentCard, loadNick, saveCard, saveNick } from '../lib/storage';
  import { cellsInCompletedRows, completedRows, isFullCard, markedCount } from '../lib/wins';

  function $<T extends Element>(selector: string): T {
    const element = document.querySelector<T>(selector);
    if (!element) throw new Error(`Missing element: ${selector}`);
    return element;
  }

  const cardFrame = $<HTMLElement>('#bingo-card');
  const grid = $<HTMLDivElement>('#bingo-grid');
  const serial = $<HTMLSpanElement>('#card-serial');
  const expiryLabel = $<HTMLSpanElement>('#card-expiry');
  const expiredStamp = $<HTMLDivElement>('#expired-stamp');
  const statusMarks = $<HTMLParagraphElement>('#status-marks');
  const statusLines = $<HTMLParagraphElement>('#status-lines');
  const newCardButton = $<HTMLButtonElement>('#new-card');
  const showCertButton = $<HTMLButtonElement>('#show-cert');
  const showCertBadButton = $<HTMLButtonElement>('#show-cert-bad');
  const cardContainer = $<HTMLDivElement>('#card-container');
  const toast = $<HTMLDivElement>('#toast');
  const toastText = $<HTMLParagraphElement>('#toast-text');
  const dialog = $<HTMLDialogElement>('#bingo-dialog');
  const nickInput = $<HTMLInputElement>('#cert-nick');
  const certCanvas = $<HTMLCanvasElement>('#cert-canvas');
  const downloadButton = $<HTMLButtonElement>('#cert-download');
  const closeButton = $<HTMLButtonElement>('#cert-close');
  const certLink = $<HTMLParagraphElement>('#cert-link');
  const copyLinkButton = $<HTMLButtonElement>('#cert-copy');
  const shareXButton = $<HTMLButtonElement>('#share-x');
  const shareBlueskyButton = $<HTMLButtonElement>('#share-bluesky');
  const shareInstagramButton = $<HTMLButtonElement>('#share-instagram');
  const shareYoutubeButton = $<HTMLButtonElement>('#share-youtube');
  const shareHint = $<HTMLParagraphElement>('#share-hint');
  const shareWhatsappButton = $<HTMLButtonElement>('#share-whatsapp');
  const shareCardButton = $<HTMLButtonElement>('#share-card');
  const emailForm = $<HTMLFormElement>('#email-form');
  const emailInput = $<HTMLInputElement>('#email-input');
  const newsletterCheck = $<HTMLInputElement>('#newsletter-check');
  const recoverForm = $<HTMLFormElement>('#recover-form');
  const recoverInput = $<HTMLInputElement>('#recover-input');
  const emailHint = $<HTMLParagraphElement>('#email-hint');

  const shortDate = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short' });
  const longDate = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long' });

  async function newCard(): Promise<CardState> {
    const fresh = generateCard();
    // Server-issued identity, clock and owner secret when reachable; the
    // locally generated ones otherwise (the card plays fine, it just won't
    // be verifiable or watchable).
    const registered = await registerCard(fresh.cells);
    if (registered) {
      fresh.id = registered.id;
      fresh.createdAt = registered.createdAt;
      fresh.secret = registered.secret;
    }
    saveCard(fresh);
    return fresh;
  }

  // Recovery link (?card=ID&k=SECRET): pull the card from the server and adopt
  // it as the current one, then clean the URL so the secret isn't left around.
  async function recoverFromUrl(): Promise<CardState | null> {
    const params = new URLSearchParams(location.search);
    const cardId = params.get('card');
    const secret = params.get('k');
    if (!cardId || !secret) return null;
    const owned = await fetchOwnedCard(cardId, secret);
    history.replaceState(null, '', location.pathname);
    if (!owned) return null;
    const recovered: CardState = { ...owned };
    saveCard(recovered);
    return recovered;
  }

  let card: CardState = (await recoverFromUrl()) ?? loadCurrentCard() ?? (await newCard());
  let cellButtons: (HTMLButtonElement | null)[] = [];
  let toastTimer: number | undefined;
  let nickSyncTimer: number | undefined;
  let marksSyncTimer: number | undefined;
  let isBadGuy = false;

  // House rule: expired cards leave the central register.
  if (isExpired(card)) discardCard(card.id, card.secret);

  // Debounced push of the marks so the shared /c/<id> view stays live.
  function scheduleMarksSync(immediate = false): void {
    if (!card.secret) return;
    const secret = card.secret;
    window.clearTimeout(marksSyncTimer);
    if (immediate) {
      syncMarks(card.id, secret, packMarks(card.marks));
      return;
    }
    marksSyncTimer = window.setTimeout(() => {
      syncMarks(card.id, secret, packMarks(card.marks));
    }, 800);
  }

  function renderGrid(): void {
    const expired = isExpired(card);
    grid.replaceChildren();
    cellButtons = card.cells.map((situationId, index) => {
      if (situationId === null) {
        const blank = document.createElement('div');
        blank.className = 'cell cell-blank';
        blank.setAttribute('aria-hidden', 'true');
        grid.append(blank);
        return null;
      }

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'cell';
      button.setAttribute('aria-pressed', String(card.marks[index]));
      button.disabled = expired;
      // Deterministic pseudo-random tilt so each dab looks hand-stamped.
      button.style.setProperty('--dab-rot', `${((index * 53) % 19) - 9}deg`);

      const text = document.createElement('span');
      text.className = 'cell-text';
      text.textContent = getSituation(situationId)?.text ?? situationId;

      const dab = document.createElement('span');
      dab.className = 'dab';
      dab.setAttribute('aria-hidden', 'true');

      button.append(text, dab);
      button.addEventListener('click', () => toggleCell(index));
      grid.append(button);
      return button;
    });

    serial.textContent = card.id;
    expiryLabel.textContent = shortDate.format(expiryDate(card));
    cardFrame.classList.toggle('card-expired', expired);
    expiredStamp.classList.toggle('hidden', !expired);
  }

  function toggleCell(index: number): void {
    if (isExpired(card)) return;

    const linesBefore = completedRows(card.cells, card.marks).length;
    card.marks[index] = !card.marks[index];

    const becameFull = isFullCard(card.cells, card.marks) && card.completedAt === null;
    if (becameFull) {
      // Local timestamp for instant feedback; the server's (authoritative)
      // one replaces it as soon as the completion is registered.
      card.completedAt = new Date().toISOString();
      echarConfetti(); // Celebra el bingo
      reportCompletion(card.id, loadNick(), card.secret).then((receipt) => {
        if (!receipt) return;
        card.completedAt = receipt.completedAt;
        saveCard(card);
        refreshCertificate();
      });
    }

    saveCard(card);
    scheduleMarksSync(becameFull);
    cellButtons[index]?.setAttribute('aria-pressed', String(card.marks[index]));
    syncStatus();

    if (becameFull) {
      openCertificate();
    } else if (completedRows(card.cells, card.marks).length > linesBefore) {
      showToast('¡Línea! Enhorabuena, supongo.');
    }
  }

  function syncStatus(): void {
    const marked = markedCount(card.cells, card.marks);
    const lines = completedRows(card.cells, card.marks).length;
    const full = isFullCard(card.cells, card.marks);
    const expired = isExpired(card);

    statusMarks.textContent = `${marked}/${SITUATION_COUNT} desgracias`;
    statusLines.textContent = expired
      ? `Caducó el ${longDate.format(expiryDate(card))}. Toca regenerar.`
      : full
        ? 'Cartón completo. Era cuestión de tiempo.'
        : lines === 0
          ? `Caduca el ${longDate.format(expiryDate(card))}.`
          : lines === 1
            ? 'Una línea cantada.'
            : `${lines} líneas cantadas.`;

    const highlighted = cellsInCompletedRows(card.cells, card.marks);
    cellButtons.forEach((button, index) => {
      button?.classList.toggle('cell-in-line', highlighted.has(index));
    });

    // The diploma survives unmarking: once sung, a bingo stays sung.
    showCertButton.classList.toggle('hidden', card.completedAt === null || isBadGuy);
    showCertBadButton.classList.toggle('hidden', card.completedAt === null || !isBadGuy);

    // Live sharing needs a registered card (owner secret in hand).
    shareCardButton.classList.toggle('hidden', card.secret === null);
  }

  function showToast(message: string): void {
    toastText.textContent = message;
    toast.classList.remove('translate-y-3', 'opacity-0');
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.add('translate-y-3', 'opacity-0');
    }, 2600);
  }

  function certificateData(): CertificateData {
    return {
      nick: nickInput.value,
      date: card.completedAt ? new Date(card.completedAt) : new Date(),
      cardId: card.id,
      badGuy: isBadGuy,
    };
  }

  function refreshCertificate(): void {
    drawCertificate(certCanvas, certificateData());
  }

  function openCertificate(): void {
    nickInput.value = loadNick();
    certLink.textContent = verificationUrl(card.id);
    refreshCertificate();
    dialog.showModal();
  }

  newCardButton.addEventListener('click', async () => {
    // Old cards stay in localStorage under their own id; only the pointer
    // moves. Expired or untouched cards regenerate without ceremony, and
    // never-completed ones leave the central register.
    const hasMarks = markedCount(card.cells, card.marks) > 0;
    if (hasMarks && !isExpired(card) && !confirm('¿Regenerar el cartón? El actual se queda archivado, con sus penas.')) {
      return;
    }
    if (card.completedAt === null) discardCard(card.id, card.secret);
    isBadGuy = false;
    card = await newCard();
    renderGrid();
    syncStatus();
  });

  // Live card sharing: native sheet on mobile, clipboard elsewhere.
  shareCardButton.addEventListener('click', async () => {
    const url = cardShareUrl(card.id);
    scheduleMarksSync(true); // make sure spectators see the latest marks
    if (navigator.share) {
      try {
        await navigator.share({
          title: 'Mi cartón del Bingo del Cargador',
          text: 'Así va mi colección de desgracias de la carga pública:',
          url,
        });
        return;
      } catch {
        // Sheet dismissed: fall through to the clipboard.
      }
    }
    try {
      await navigator.clipboard.writeText(url);
      showToast('Enlace copiado. Que sufran contigo.');
    } catch {
      showToast(url);
    }
  });

  // Link an email to the current card so it can be recovered later.
  emailForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = emailInput.value.trim();
    if (!email) return;
    if (!card.secret) {
      emailHint.textContent = 'Este cartón no está registrado; regenera uno para poder guardarlo.';
      return;
    }
    emailHint.textContent = 'Vinculando…';
    const ok = await linkEmail(card.id, card.secret, email, newsletterCheck.checked);
    emailHint.textContent = ok
      ? newsletterCheck.checked
        ? 'Cartón guardado y apuntado a la newsletter. Gracias.'
        : 'Cartón guardado. Recupéralo cuando quieras desde aquí.'
      : 'No se pudo guardar. Inténtalo más tarde.';
  });

  // Ask the server to email the player their card links.
  recoverForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = recoverInput.value.trim();
    if (!email) return;
    emailHint.textContent = 'Enviando…';
    await requestRecovery(email);
    // Always the same message: we don't reveal whether the email had cards.
    emailHint.textContent = 'Si hay cartones con ese correo, te llegará un email con los enlaces.';
  });

  // Doble click en el cartón: activar modo "sinvergüenza"
  cardContainer.addEventListener('dblclick', () => {
    if (card.completedAt) {
      isBadGuy = !isBadGuy;
      syncStatus();
      if (card.completedAt) refreshCertificate();
    }
  });

  showCertButton.addEventListener('click', () => {
    isBadGuy = false;
    openCertificate();
  });
  showCertBadButton.addEventListener('click', () => {
    isBadGuy = true;
    openCertificate();
  });

  nickInput.addEventListener('input', () => {
    saveNick(nickInput.value);
    refreshCertificate();
    // Completed cards sync the diploma nick to the register, debounced.
    if (card.completedAt === null) return;
    window.clearTimeout(nickSyncTimer);
    nickSyncTimer = window.setTimeout(() => {
      void reportCompletion(card.id, nickInput.value, card.secret);
    }, 600);
  });

  copyLinkButton.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(verificationUrl(card.id));
      copyLinkButton.textContent = 'Copiado';
      window.setTimeout(() => (copyLinkButton.textContent = 'Copiar'), 1500);
    } catch {
      // Clipboard unavailable (permissions/old browser): the link stays
      // visible right next to the button for manual copying.
    }
  });

  // --- Sharing ------------------------------------------------------------

  function shareText(): string {
    return `He completado «El Bingo del Cargador» de @gruxon: seis desgracias de la carga pública, dentro del plazo. Diploma verificable: ${verificationUrl(card.id)}`;
  }

  function openShareWindow(url: string): void {
    window.open(url, '_blank', 'noopener');
  }

  async function copyShareText(): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(shareText());
      return true;
    } catch {
      return false;
    }
  }

  function setShareHint(message: string): void {
    shareHint.textContent = message;
  }

  async function diplomaFile(): Promise<File | null> {
    // toBlob can be slow (or pathologically silent) on some engines; cap the
    // wait so the share button always falls back instead of hanging.
    const blob = await Promise.race([
      new Promise<Blob | null>((resolve) => certCanvas.toBlob(resolve, 'image/png')),
      new Promise<null>((resolve) => window.setTimeout(() => resolve(null), 2000)),
    ]);
    if (!blob) return null;
    return new File([blob], `certificado-bingo-cargador-${card.id}.png`, { type: 'image/png' });
  }

  shareWhatsappButton.addEventListener('click', () => {
    openShareWindow(`https://wa.me/?text=${encodeURIComponent(shareText())}`);
  });

  shareXButton.addEventListener('click', () => {
    openShareWindow(`https://x.com/intent/post?text=${encodeURIComponent(shareText())}`);
  });

  shareBlueskyButton.addEventListener('click', () => {
    openShareWindow(`https://bsky.app/intent/compose?text=${encodeURIComponent(shareText())}`);
  });

  shareInstagramButton.addEventListener('click', async () => {
    // Instagram has no web compose intent. On mobile, hand the PNG to the
    // system share sheet (Instagram shows up there); elsewhere, copy the
    // caption and open the profile.
    const file = await diplomaFile();
    if (file && navigator.canShare?.({ files: [file] })) {
      try {
        await navigator.share({ files: [file], text: shareText() });
        return;
      } catch {
        // Sheet dismissed or unsupported combo: fall back below.
      }
    }
    const copied = await copyShareText();
    openShareWindow('https://www.instagram.com/gruxon/');
    setShareHint(
      copied
        ? 'Texto copiado. Instagram no deja precargar nada: pega y sube el PNG a mano.'
        : 'Instagram no deja precargar nada: descarga el PNG y súbelo a mano.',
    );
  });

  shareYoutubeButton.addEventListener('click', async () => {
    // YouTube has no share intent at all: copy the caption, open the channel.
    const copied = await copyShareText();
    openShareWindow('https://www.youtube.com/@gruxon');
    setShareHint(
      copied
        ? 'Texto copiado. En YouTube, al menos, que conste la cita.'
        : 'YouTube no deja precargar nada. La cita, de memoria.',
    );
  });

  downloadButton.addEventListener('click', () => downloadCertificate(certCanvas, certificateData()));
  closeButton.addEventListener('click', () => dialog.close());

  renderGrid();
  syncStatus();
</script>
