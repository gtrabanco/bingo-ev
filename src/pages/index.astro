  const vehicleTypeSelect = $<HTMLSelectElement>('#vehicle-type-select');

  const shortDate = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short' });
  const longDate = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long' });

  // Wide screens show the paperwork column expanded: collapsed bars floating
  // next to the cartón look half-broken, and there's room to spare. This runs
  // BEFORE the card-loading awaits below — done later it would flash closed
  // panels for seconds on slow networks and stomp on the user's own toggles.
  if (matchMedia('(min-width: 1024px)').matches) {
    for (const panel of document.querySelectorAll('main details')) {
      panel.setAttribute('open', '');
    }
  }

  // Polls window._ts (set by the is:inline Turnstile callback) for up to `ms`
  // milliseconds. Returns the token when ready or an empty string on timeout.
  async function getTsToken(ms = 2000): Promise<string> {
    const ts = (window as any)._ts as { token: string; ready: boolean } | undefined;
    if (!ts) return '';
    const deadline = Date.now() + ms;
    while (Date.now() < deadline) {
      if (ts.ready) return ts.token;
      await new Promise<void>((r) => setTimeout(r, 50));
    }
    return ts.token;
  }

  function resetTs(): void {
    const ts = (window as any)._ts as { token: string; ready: boolean } | undefined;
    if (!ts) return;
    ts.ready = false;
    ts.token = '';
    (window as any).turnstile?.reset(document.querySelector('.cf-turnstile'));
  }

  async function newCard(): Promise<CardState> {
    const fresh = generateCard();
    // Server-issued identity, clock and owner secret when reachable; the
    // locally generated ones otherwise (the card plays fine, it just won't
    // be verifiable or watchable). The alias rides along so the card is
    // born labelled.
    const tsToken = await getTsToken();
    const registered = await registerCard(fresh.cells, loadAlias(), tsToken, loadVehicleType());
    if (tsToken) resetTs();
    if (registered) {
      fresh.id = registered.id;
      fresh.createdAt = registered.createdAt;
      fresh.secret = registered.secret;
    }
    saveCard(fresh);
    return fresh;
  }

  // Recovery link (?card=ID&k=SECRET): pull the card from the server and adopt
  // it as the current one, then clean the URL so the secret isn't left around.
  async function recoverFromUrl(): Promise<CardState | null> {
    const params = new URLSearchParams(location.search);
    const cardId = params.get('card');
    const secret = params.get('k');
    if (!cardId || !secret) return null;
    const owned = await fetchOwnedCard(cardId, secret);
    history.replaceState(null, '', location.pathname);
    if (!owned) return null;

    const { alias, vehicleType, ...incomingState } = owned;
    const existing = loadCurrentCard();

    // Idempotent: same card already in localStorage.
    if (existing?.id === cardId) {
      if (alias && !loadAlias()) saveAlias(alias);
      if (vehicleType && !loadVehicleType()) saveVehicleType(vehicleType);
      const recovered: CardState = { ...incomingState };
      saveCard(recovered);
      return recovered;
    }

    // Trivial existing card: 0 marks, no group, not completed, or no secret.
    const trivial =
      !existing ||
      !existing.secret ||
      (existing.marks.every((m) => m === 0) && !existing.groupId && !existing.completedAt);

    if (trivial) {
      if (alias && !loadAlias()) saveAlias(alias);
      if (vehicleType && !loadVehicleType()) saveVehicleType(vehicleType);
      const recovered: CardState = { ...incomingState };
      saveCard(recovered);
      return recovered;
    }

    // Non-trivial collision: build ConflictCardInfo for both cards, then show dialog.
    const existingInfo: ConflictCardInfo = {
      cardId: existing.id,
      marks: packMarks(existing.marks),
      groupId: existing.groupId,
      groupName: null,
      isGroupOwner: false,
    };
    const incomingInfo: ConflictCardInfo = {
      cardId,
      marks: packMarks(incomingState.marks),
      groupId: incomingState.groupId,
      groupName: null,
      isGroupOwner: false,
    };

    // Fetch group name + ownership in parallel; dialog degrades gracefully on failure.
    await Promise.all([
      existing.groupId
        ? fetchGroupStandings(existing.groupId, existing.id, existing.secret).then((s) => {
            if (s) {
              existingInfo.groupName = s.name;
              existingInfo.isGroupOwner = s.ownerCardId === existing.id;
            }
          }).catch(() => {})
        : Promise.resolve(),
      incomingState.groupId
        ? fetchGroupStandings(incomingState.groupId, cardId, secret).then((s) => {
            if (s) {
              incomingInfo.groupName = s.name;
              incomingInfo.isGroupOwner = s.ownerCardId === cardId;
            }
          }).catch(() => {})
        : Promise.resolve(),
    ]);

    showConflictDialog(
      { existing: existingInfo, incoming: incomingInfo },
      cardId,
      secret,
      'local',
      existing.secret,
      { ...incomingState },
    );

    // Existing card stays active until the player resolves the dialog.
    return null;
  }

  let card: CardState = (await recoverFromUrl()) ?? loadCurrentCard() ?? (await newCard());
  let cellButtons: (HTMLButtonElement | null)[] = [];
  let toastTimer: number | undefined;
  let nickSyncTimer: number | undefined;
  let marksSyncTimer: number | undefined;
  let pendingTapTimer: number | undefined;
  let markMode: MarkMode = loadMarkMode();

  const MODE_HINTS: Record<MarkMode, string> = {
    sin: 'Todo lo que marques lo causaste tú. Valiente confesión.',
    mix: 'Un toque: la sufriste. Doble toque: la causaste tú, sinvergüenza.',
    ev: 'Todo lo que marques te pasó a ti. Pobre.',
  };

  function setMarkMode(mode: MarkMode): void {
    markMode = mode;
    saveMarkMode(mode);
    for (const [key, button] of Object.entries(modeButtons)) {
      button.setAttribute('aria-pressed', String(key === mode));
    }
    modeHint.textContent = MODE_HINTS[mode];
  }

  // House rule: expired cards leave the central register.
  if (isExpired(card)) discardCard(card.id, card.secret);

  // Debounced push of the marks so the shared /c/<id> view stays live.
  // If the server returns 409 (marks sealed) we re-fetch and restore canonical state.
  function scheduleMarksSync(immediate = false): void {
    if (!card.secret) return;
    const secret = card.secret;
    window.clearTimeout(marksSyncTimer);
    const doSync = async () => {
      const result = await syncMarks(card.id, secret, packMarks(card.marks));
      if (result === 'locked') {
        // Server rejected: the diploma is sealed. Re-fetch to restore server state.
        const owned = await fetchOwnedCard(card.id, card.secret!);
        if (owned) {
          card.marks = owned.marks;
          card.completedAt = owned.completedAt;
          saveCard(card);
          renderGrid();
          syncStatus();
          showToast('El cartón ya estaba sellado. Se restauró su estado.');
        }
      }
    };
    if (immediate) {
      void doSync();
      return;
    }
    marksSyncTimer = window.setTimeout(() => { void doSync(); }, 800);
  }

  function renderGrid(): void {
    const expired = isExpired(card);
    const locked = card.completedAt !== null && areMarksLocked(card.completedAt);
    grid.replaceChildren();
    cellButtons = card.cells.map((situationId, index) => {
      if (situationId === null) {
        const blank = document.createElement('div');
        blank.className = 'cell cell-blank';
        blank.setAttribute('aria-hidden', 'true');
        grid.append(blank);
        return null;
      }

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'cell';
      button.setAttribute('aria-pressed', String((card.marks[index] ?? 0) > 0));
      button.disabled = expired || locked;
      // Deterministic pseudo-random tilt so each dab looks hand-stamped.
      button.style.setProperty('--dab-rot', `${((index * 53) % 19) - 9}deg`);

      const text = document.createElement('span');
      text.className = 'cell-text';
      text.textContent = getSituation(situationId)?.text ?? situationId;

      const dab = document.createElement('span');
      dab.className = 'dab';
      dab.setAttribute('aria-hidden', 'true');

      button.append(text, dab);
      button.dataset.kind = String(card.marks[index]);
      button.addEventListener('click', () => onCellClick(index));
      button.addEventListener('dblclick', () => onCellDblClick(index));
      grid.append(button);
      return button;
    });

    serial.textContent = card.id;
    expiryLabel.textContent = shortDate.format(expiryDate(card));
    cardFrame.classList.toggle('card-expired', expired);
    expiredStamp.classList.toggle('hidden', !expired);
  }

  // Routes a tap according to the marking mode. In 'mix' mode the single tap
  // waits a beat so a double tap (mark as caused) can cancel it.
  function onCellClick(index: number): void {
    if (markMode === 'mix') {
      window.clearTimeout(pendingTapTimer);
      pendingTapTimer = window.setTimeout(() => toggleCell(index, 1), 250);
      return;
    }
    toggleCell(index, markMode === 'sin' ? 2 : 1);
  }

  function onCellDblClick(index: number): void {
    if (markMode !== 'mix') return;
    window.clearTimeout(pendingTapTimer);
    toggleCell(index, 2);
  }

  function toggleCell(index: number, kind: 1 | 2): void {
    if (isExpired(card)) return;

    // Locked: past the 24h grace window — marks are sealed, diploma can't be revoked.
    if (card.completedAt && areMarksLocked(card.completedAt)) {
      showToast('Este cartón ya está sellado. No se aceptan más cambios.');
      return;
    }

    const linesBefore = completedRows(card.cells, card.marks).length;
    const wasCompleted = card.completedAt !== null;
    // Same kind again unmarks; anything else stamps (or restamps) the kind.
    card.marks[index] = card.marks[index] === kind ? 0 : kind;

    const becameFull = isFullCard(card.cells, card.marks) && !wasCompleted;
    const wasInvalidated = wasCompleted && !isFullCard(card.cells, card.marks);

    if (becameFull) {
      // Local timestamp for instant feedback; the server's (authoritative)
      // one replaces it as soon as the completion is registered.
      card.completedAt = new Date().toISOString();
      echarConfetti(); // Celebra el bingo
      reportCompletion(card.id, loadNick(), card.secret).then((receipt) => {
        if (!receipt) return;
        card.completedAt = receipt.completedAt;
        saveCard(card);
        refreshCertificate();
        if (receipt.nickError) {
          showToast(`${receipt.nickError}. Elige otro nombre para el diploma.`);
        }
      });
    } else if (wasInvalidated) {
      // Un-marked within grace window, bingo no longer holds: revoke diploma.
      card.completedAt = null;
    }

    saveCard(card);
    scheduleMarksSync(becameFull);
    const button = cellButtons[index];
    if (button) {
      button.setAttribute('aria-pressed', String((card.marks[index] ?? 0) > 0));
      button.dataset.kind = String(card.marks[index]);
    }
    syncStatus();

    if (becameFull) {
      openCertificate();
    } else if (wasInvalidated) {
      showToast('Diploma anulado. Queda cartón por sufrir.');
    } else if (completedRows(card.cells, card.marks).length > linesBefore) {
      showToast('¡Línea! Enhorabuena, supongo.');
    }
  }

  function syncStatus(): void {
    const marked = markedCount(card.cells, card.marks);
    const lines = completedRows(card.cells, card.marks).length;
    const full = isFullCard(card.cells, card.marks);
    const expired = isExpired(card);
    const locked = card.completedAt !== null && areMarksLocked(card.completedAt);

    statusMarks.textContent = `${marked}/${SITUATION_COUNT} desgracias`;
    statusLines.textContent = expired
      ? `Caducó el ${longDate.format(expiryDate(card))}. Toca regenerar.`
      : locked
        ? 'Cartón sellado. Ya no hay marcha atrás.'
        : full
          ? 'Cartón completo. Era cuestión de tiempo.'
          : lines === 0
            ? `Caduca el ${longDate.format(expiryDate(card))}.`
            : lines === 1
              ? 'Una línea cantada.'
              : `${lines} líneas cantadas.`;

    const highlighted = cellsInCompletedRows(card.cells, card.marks);
    cellButtons.forEach((button, index) => {
      button?.classList.toggle('cell-in-line', highlighted.has(index));
    });

    // Diploma shown while completedAt is set (revoked on un-mark within grace, sealed after lock).
    showCertButton.classList.toggle('hidden', card.completedAt === null);

    // Gallery toggle: only shown for completed cards with a secret (owned).
    const isCompleted = card.completedAt !== null;
    galleryToggleBtn.classList.toggle('hidden', !isCompleted || card.secret === null);

    // Device-code button: shown whenever a registered card exists (has id + secret).
    deviceCodeBtn?.classList.toggle('hidden', !card.id || card.secret === null);
    if (isCompleted) {
      galleryToggleBtn.setAttribute('aria-pressed', String(galleryHidden));
      galleryToggleBtn.textContent = galleryHidden
        ? 'Mostrar en la galería pública'
        : 'Ocultar de la galería pública';
    }

    // Live sharing needs a registered card (owner secret in hand).
    shareCardButton.classList.toggle('hidden', card.secret === null);
  }

  function showToast(message: string): void {
    toastText.textContent = message;
    toast.classList.remove('translate-y-3', 'opacity-0');
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.add('translate-y-3', 'opacity-0');
    }, 2600);
  }

  function certificateData(): CertificateData {
    return {
      nick: nickInput.value,
      date: card.completedAt ? new Date(card.completedAt) : new Date(),
      cardId: card.id,
      honorific: honorificFor(card.cells, card.marks),
    };
  }

  function refreshCertificate(): void {
    drawCertificate(certCanvas, certificateData());
  }

  function openCertificate(): void {
    nickInput.value = loadNick();
    certLink.textContent = verificationUrl(card.id);
    refreshCertificate();
    dialog.showModal();
  }

  newCardButton.addEventListener('click', async () => {
    // Old cards stay in localStorage under their own id; only the pointer
    // moves. Expired or untouched cards regenerate without ceremony, and
    // never-completed ones leave the central register.
    const hasMarks = markedCount(card.cells, card.marks) > 0;
    if (hasMarks && !isExpired(card) && !confirm('¿Regenerar el cartón? El actual se queda archivado, con sus penas.')) {
      return;
    }
    if (card.completedAt === null) discardCard(card.id, card.secret);
    card = await newCard();
    renderGrid();
    syncStatus();
    // A fresh cartón belongs to no group: the create form comes back.
    renderGroupPanel();
  });

  // Live card sharing: native sheet on mobile, clipboard elsewhere.
  shareCardButton.addEventListener('click', async () => {
    const url = cardShareUrl(card.id);
    scheduleMarksSync(true); // make sure spectators see the latest marks
    if (navigator.share) {
      try {
        await navigator.share({
          title: 'Mi cartón del Bingo del Cargador',
          text: 'Así va mi colección de desgracias de la carga pública:',
          url,
        });
        return;
      } catch {
        // Sheet dismissed: fall through to the clipboard.
      }
    }
    try {
      await navigator.clipboard.writeText(url);
      showToast('Enlace copiado. Que sufran contigo.');
    } catch {
      showToast(url);
    }
  });

  // Gallery visibility toggle: hide/show this diploma in the public gallery.
  galleryToggleBtn.addEventListener('click', async () => {
    if (!card.secret || !card.completedAt) return;
    const next = !galleryHidden;
    const ok = await setGalleryHidden(card.id, card.secret, next);
    if (ok) {
      galleryHidden = next;
      syncStatus();
      showToast(next ? 'Diploma oculto de la galería.' : 'Diploma visible en la galería.');
    } else {
      showToast('No se pudo cambiar la visibilidad. Inténtalo de nuevo.');
    }
  });

  // Link an email to the current card so it can be recovered later.
  emailForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = emailInput.value.trim();
    if (!email) return;
    if (!card.secret) {
      emailHint.textContent = 'Este cartón no está registrado; regenera uno para poder guardarlo.';
      return;
    }
    emailHint.textContent = 'Vinculando…';
    const wantsNewsletter = newsletterCheck.checked;
    const ok = await linkEmail(card.id, card.secret, email, wantsNewsletter);
    emailHint.textContent = ok
      ? wantsNewsletter
        ? 'Cartón guardado y apuntado a la newsletter. Gracias.'
        : 'Cartón guardado. Recupéralo cuando quieras desde aquí.'
      : 'No se pudo guardar. Inténtalo más tarde.';
    // No confirmation email: the form is the confirmation. Record the opt-in
    // locally so we don't keep offering the newsletter on this device.
    if (ok && wantsNewsletter) {
      markNewsletterSubscribed();
      newsletterLabel?.classList.add('hidden');
    }
  });

  // Ask the server to email the player their card links.
  recoverForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = recoverInput.value.trim();
    if (!email) return;
    emailHint.textContent = 'Enviando…';
    const tsToken = await getTsToken();
    await requestRecovery(email, tsToken);
    if (tsToken) resetTs();
    // Always the same message: we don't reveal whether the email had cards.
    emailHint.textContent = 'Si hay cartones con ese correo, te llegará un email con los enlaces.';
  });

  // Marking-mode toggle.
  for (const [key, button] of Object.entries(modeButtons)) {
    button.addEventListener('click', () => setMarkMode(key as MarkMode));
  }

  // --- Alias ---------------------------------------------------------------
  // A display label, never an identity: it shows up in group standings and
  // travels with the card. Set once above the card (no group needed); once
  // set, it renders as text with an edit button instead of an input.

  function vehicleSelectDone(): boolean {
    return isVehicleTypeSeen() || loadVehicleType() !== null;
  }

  function renderAlias(): void {
    const alias = loadAlias();
    aliasLabel.textContent = `«${alias}»`;
    aliasDisplay.classList.toggle('hidden', alias === '');
    aliasForm.classList.toggle('hidden', alias !== '');
    vehicleTypeRow.classList.toggle('hidden', vehicleSelectDone());
  }

  function editAlias(): void {
    aliasInput.value = loadAlias();
    aliasDisplay.classList.add('hidden');
    aliasForm.classList.remove('hidden');
    vehicleTypeRow.classList.toggle('hidden', vehicleSelectDone());
    aliasInput.focus();
  }

  // Tesla UA hint: pre-select bev_tesla if the player hasn't answered yet.
  if (navigator.userAgent.includes('Tesla') && !vehicleSelectDone()) {
    vehicleTypeSelect.value = 'bev_tesla';
  }

  aliasEditButton.addEventListener('click', editAlias);

  aliasForm.addEventListener('submit', (event) => {
    event.preventDefault();
    const alias = aliasInput.value.trim().slice(0, 32);
    if (!alias) return;
    saveAlias(alias);
    // First submission: record the selection (empty string = "Prefiero no decirlo" = null)
    // and mark as seen so the selector never reappears.
    if (!vehicleSelectDone()) {
      const selected = vehicleTypeSelect.value || null;
      if (selected) saveVehicleType(selected);
      markVehicleTypeSeen();
    }
    // The server copy follows when the card is registered, so standings and
    // shared views pick the new label up.
    if (card.secret) syncAlias(card.id, card.secret, alias, loadVehicleType());
    renderAlias();
  });

  // --- Group panel ----------------------------------------------------------
  // One card, one group: while the current card plays in a group, the panel
  // offers the way in (board + ranking) instead of the create form. A fresh
  // cartón brings the form back.

  function renderGroupPanel(): void {
    const groupId = card.groupId;
    groupCurrentBox.classList.toggle('hidden', !groupId);
    groupCreateBox.classList.toggle('hidden', !!groupId);
    if (groupId) groupLink.href = `/g/${groupId}`;
  }

  // The server rules membership (the admin may have kicked this card, or it
  // joined from another device): refresh quietly and re-render on change.
  async function refreshGroupMembership(): Promise<void> {
    if (!card.secret) return;
    const owned = await fetchOwnedCard(card.id, card.secret);
    if (!owned || owned.id !== card.id) return;
    const serverGroup = owned.groupId ?? null;
    if (serverGroup !== card.groupId) {
      card.groupId = serverGroup;
      saveCard(card);
      renderGroupPanel();
    }
  }

  // Show the password field only when the group is password-protected.
  function syncGroupPasswordVisibility(): void {
    const policy = (groupForm.elements.namedItem('group-join') as RadioNodeList).value;
    const password = policy === 'password';
    groupPasswordInput.classList.toggle('hidden', !password);
    groupPasswordInput.required = password;
  }
  groupForm.addEventListener('change', (event) => {
    if ((event.target as HTMLElement).getAttribute('name') === 'group-join') {
      syncGroupPasswordVisibility();
    }
  });
  syncGroupPasswordVisibility();

  // Create a bingo group, auto-join the current card and jump to its page.
  groupForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const name = groupNameInput.value.trim();
    if (!name) return;
    // A completed card can't join any room (instant unearned win), so letting
    // it create one would leave an owner locked out of their own sala.
    if (card.completedAt !== null) {
      groupHint.textContent = 'Tu cartón ya está completo: regenera uno para crear un grupo.';
      return;
    }
    // The global alias (above the card) is how you appear in the standings.
    const alias = loadAlias();
    if (!alias) {
      groupHint.textContent = 'Te falta un alias: ponlo encima del cartón.';
      editAlias();
      return;
    }
    const policy = (groupForm.elements.namedItem('group-join') as RadioNodeList).value;
    const joinPolicy = policy === 'password' ? 'password' : 'open';
    const password = groupPasswordInput.value;
    if (joinPolicy === 'password' && !password) {
      groupHint.textContent = 'Pon una contraseña para el grupo.';
      return;
    }

    groupHint.textContent = 'Creando…';
    const tsToken = await getTsToken();
    // The creator's card becomes the owner: it kicks, deletes and hands the
    // office over if it ever leaves the room.
    const result = await createGroup(
      name,
      {
        joinPolicy,
        password,
        publicBoard: groupPublicCheck.checked,
      },
      card.secret ? { cardId: card.id, secret: card.secret } : null,
      tsToken,
    );
    if (tsToken) resetTs();
    if (!result.ok) {
      groupHint.textContent =
        result.error === 'name_taken'
          ? 'Ese nombre ya está cogido. Prueba con otro.'
          : result.error === 'card_completed'
            ? 'Tu cartón ya está completo: regenera uno para crear un grupo.'
            : result.error === 'ratelimited'
              ? 'Demasiados intentos seguidos. Espera un momento.'
              : 'No se pudo crear el grupo. Inténtalo más tarde.';
      return;
    }

    // Auto-join the creator's card so they land already in the standings.
    if (card.secret && card.completedAt === null) {
      const joined = await joinGroup(result.id, card.id, card.secret, alias, password);
      if (joined.ok) {
        card.groupId = result.id;
        saveCard(card);
      }
    }
    location.href = `/g/${result.id}`;
  });

  showCertButton.addEventListener('click', openCertificate);

  nickInput.addEventListener('input', () => {
    saveNick(nickInput.value);
    refreshCertificate();
    // Completed cards sync the diploma nick to the register, debounced.
    if (card.completedAt === null) return;
    window.clearTimeout(nickSyncTimer);
    nickSyncTimer = window.setTimeout(() => {
      void reportCompletion(card.id, nickInput.value, card.secret);
    }, 600);
  });

  copyLinkButton.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(verificationUrl(card.id));
      copyLinkButton.textContent = 'Copiado';
      window.setTimeout(() => (copyLinkButton.textContent = 'Copiar'), 1500);
    } catch {
      // Clipboard unavailable (permissions/old browser): the link stays
      // visible right next to the button for manual copying.
    }
  });

  // --- Sharing ------------------------------------------------------------

  function shareText(platform: 'bluesky' | 'default' = 'default'): string {
    const mention = platform === 'bluesky' ? '@gtrabanco.bsky.social' : '@GabrielTrabanco';
    const tags = '#BingoDelCargador #EVEspaña #Tesla';
    return `He completado «El Bingo del Cargador» (cc ${mention}): seis desgracias de la carga pública, dentro del plazo. ${tags} Diploma verificable: ${verificationUrl(card.id)}`;
  }

  function openShareWindow(url: string): void {
    window.open(url, '_blank', 'noopener');
  }

  async function copyShareText(): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(shareText());
      return true;
    } catch {
      return false;
    }
  }

  function setShareHint(message: string): void {
    shareHint.textContent = message;
  }

  async function diplomaFile(): Promise<File | null> {
    // toBlob can be slow (or pathologically silent) on some engines; cap the
    // wait so the share button always falls back instead of hanging.
    const blob = await Promise.race([
      new Promise<Blob | null>((resolve) => certCanvas.toBlob(resolve, 'image/png')),
      new Promise<null>((resolve) => window.setTimeout(() => resolve(null), 2000)),
    ]);
    if (!blob) return null;
    return new File([blob], `certificado-bingo-cargador-${card.id}.png`, { type: 'image/png' });
  }

  shareWhatsappButton.addEventListener('click', () => {
    openShareWindow(`https://wa.me/?text=${encodeURIComponent(shareText())}`);
  });

  shareXButton.addEventListener('click', () => {
    openShareWindow(`https://x.com/intent/post?text=${encodeURIComponent(shareText())}`);
  });

  shareBlueskyButton.addEventListener('click', () => {
    openShareWindow(`https://bsky.app/intent/compose?text=${encodeURIComponent(shareText('bluesky'))}`);
  });

  shareInstagramButton.addEventListener('click', async () => {
    // Instagram has no web compose intent. Prefer the portrait (9:16) Story
    // PNG from the server — better for Stories than the landscape canvas PNG.
    // On mobile the system share sheet picks up Instagram from the file share;
    // otherwise copy the caption and open the profile as a last resort.
    async function storyFile(): Promise<File | null> {
      try {
        const resp = await fetch(`/og/diploma/${card.id}-story.png`, {
          signal: AbortSignal.timeout(4000),
        });
        if (!resp.ok || !resp.headers.get('content-type')?.startsWith('image/png')) return null;
        const blob = await resp.blob();
        return new File([blob], `diploma-story-${card.id}.png`, { type: 'image/png' });
      } catch {
        return null;
      }
    }

    const file = (await storyFile()) ?? (await diplomaFile());
    if (file && navigator.canShare?.({ files: [file] })) {
      try {
        await navigator.share({ files: [file], text: shareText() });
        return;
      } catch {
        // Sheet dismissed or unsupported combo: fall back below.
      }
    }
    const copied = await copyShareText();
    openShareWindow('https://www.instagram.com/gruxon/');
    setShareHint(
      copied
        ? 'Texto copiado. Instagram no deja precargar nada: pega y sube el PNG a mano.'
        : 'Instagram no deja precargar nada: descarga el PNG y súbelo a mano.',
    );
  });

  shareYoutubeButton.addEventListener('click', async () => {
    // YouTube has no share intent at all: copy the caption, open the channel.
    const copied = await copyShareText();
    openShareWindow('https://www.youtube.com/@gruxon');
    setShareHint(
      copied
        ? 'Texto copiado. En YouTube, al menos, que conste la cita.'
        : 'YouTube no deja precargar nada. La cita, de memoria.',
    );
  });

  downloadButton.addEventListener('click', () => downloadCertificate(certCanvas, certificateData()));
  closeButton.addEventListener('click', () => dialog.close());

  // Already subscribed on this device: don't offer the newsletter again.
  if (isNewsletterSubscribed()) newsletterLabel?.classList.add('hidden');

  setMarkMode(markMode);
  renderAlias();
  renderGroupPanel();
  renderGrid();
  syncStatus();
  void refreshGroupMembership();

  // -------------------------------------------------------------------------
  // Account bar (feature 05-accounts)
  // -------------------------------------------------------------------------

  const accountBar = $<HTMLDivElement>('#account-bar');
  const accountLoggedOut = document.querySelector<HTMLDivElement>('#account-loggedout');
  const accountLoggedIn = document.querySelector<HTMLDivElement>('#account-loggedin');
  const accountLabel = document.querySelector<HTMLSpanElement>('#account-label');
  const btnLoginGoogle = document.querySelector<HTMLButtonElement>('#btn-login-google');
  const btnLoginX = document.querySelector<HTMLButtonElement>('#btn-login-x');
  const btnLogout = $<HTMLButtonElement>('#btn-logout');
  const btnDeleteAccount = $<HTMLButtonElement>('#btn-delete-account');
  const deleteAccountDialog = $<HTMLDialogElement>('#delete-account-dialog');
  const btnDeleteAccountCancel = $<HTMLButtonElement>('#btn-delete-account-cancel');
  const btnDeleteAccountConfirm = $<HTMLButtonElement>('#btn-delete-account-confirm');
  const deleteAccountError = $<HTMLParagraphElement>('#delete-account-error');

  // Profile control elements (feature 09)
  const profileNone = $<HTMLDivElement>('#profile-none');
  const profileActive = $<HTMLDivElement>('#profile-active');
  const profileFormWrap = $<HTMLDivElement>('#profile-form-wrap');
  const profileLink = $<HTMLAnchorElement>('#profile-link');
  const profileHandleInput = $<HTMLInputElement>('#profile-handle-input');
  const profileError = $<HTMLParagraphElement>('#profile-error');
  const btnCreateProfile = $<HTMLButtonElement>('#btn-create-profile');
  const btnEditProfile = $<HTMLButtonElement>('#btn-edit-profile');
  const btnDisableProfile = $<HTMLButtonElement>('#btn-disable-profile');
  const btnSaveProfile = $<HTMLButtonElement>('#btn-save-profile');
  const btnCancelProfile = $<HTMLButtonElement>('#btn-cancel-profile');

  let currentHandle: string | null = null;

  type ProfileState = 'none' | 'active' | 'form';

  function showProfileError(msg: string): void {
    if (!profileError) return;
    profileError.textContent = msg;
    profileError.classList.remove('hidden');
  }

  function clearProfileError(): void {
    if (!profileError) return;
    profileError.textContent = '';
    profileError.classList.add('hidden');
  }

  function renderProfileControl(state: ProfileState, handle?: string | null, moveFocus = false): void {
    const none = state === 'none';
    const active = state === 'active';
    const form = state === 'form';

    profileNone?.classList.toggle('hidden', !none);
    if (profileActive) {
      profileActive.classList.toggle('hidden', !active);
      profileActive.classList.toggle('flex', active);
    }
    if (profileFormWrap) {
      profileFormWrap.classList.toggle('hidden', !form);
      profileFormWrap.classList.toggle('flex', form);
    }
    clearProfileError();

    if (active && handle && profileLink) {
      profileLink.textContent = `@${handle}`;
      profileLink.href = `/jugador/${handle}`;
    }
    if (form && profileHandleInput) {
      profileHandleInput.value = handle ?? '';
      profileHandleInput.focus();
    } else if (moveFocus) {
      if (active) btnEditProfile?.focus();
      else if (none) btnCreateProfile?.focus();
    }
  }

  async function saveProfile(handle: string, isPublic: boolean): Promise<void> {
    clearProfileError();
    if (btnSaveProfile) btnSaveProfile.disabled = true;
    const result = await setProfile(handle, isPublic);
    if (btnSaveProfile) btnSaveProfile.disabled = false;

    if (result.ok) {
      currentHandle = handle;
      renderProfileControl(isPublic ? 'active' : 'none', handle, true);
      return;
    }
    // Map typed errors; blocklist messages are already Spanish strings.
    if (result.error === 'handle_invalid') {
      showProfileError('Nombre no válido. Usa letras minúsculas, números y guiones (3–24 caracteres).');
    } else if (result.error === 'handle_taken') {
      showProfileError('Ese nombre ya está cogido. Prueba con otro.');
    } else if (result.error === 'offline') {
      showProfileError('No se pudo guardar. Comprueba tu conexión.');
    } else {
      showProfileError(result.error);
    }
  }

  const hasProviders = accountBar?.dataset.hasProviders === 'true';

  // -------------------------------------------------------------------------
  // Conflict resolution dialog (feature 10-multi-card-conflict)
  // -------------------------------------------------------------------------

  type ConflictCardInfo = {
    cardId: string;
    marks: string;
    groupId: string | null;
    groupName: string | null;
    isGroupOwner: boolean;
  };
  type ConflictPayload = { existing: ConflictCardInfo; incoming: ConflictCardInfo };
  type ConflictState = {
    incomingCardId: string;
    incomingSecret: string;
    conflict: ConflictPayload;
    pendingAction: 'keep-incoming' | 'keep-existing' | null;
    default: 'incoming' | 'existing';
    mode: 'account' | 'local';
    existingSecret: string | null;
    incomingCardState: CardState | null;
  };
  let conflictState: ConflictState | null = null;

  const conflictDialog = $<HTMLDialogElement>('#conflict-dialog');
  const conflictMain = $<HTMLDivElement>('#conflict-main');
  const conflictOwnerWarn = $<HTMLDivElement>('#conflict-owner-warn');
  const conflictIncomingMarks = $<HTMLParagraphElement>('#conflict-incoming-marks');
  const conflictIncomingGroup = $<HTMLParagraphElement>('#conflict-incoming-group');
  const conflictIncomingOwner = $<HTMLParagraphElement>('#conflict-incoming-owner');
  const conflictExistingMarks = $<HTMLParagraphElement>('#conflict-existing-marks');
  const conflictExistingGroup = $<HTMLParagraphElement>('#conflict-existing-group');
  const conflictExistingOwner = $<HTMLParagraphElement>('#conflict-existing-owner');
  const conflictError = $<HTMLParagraphElement>('#conflict-error');
  const btnKeepIncoming = $<HTMLButtonElement>('#btn-keep-incoming');
  const btnKeepExisting = $<HTMLButtonElement>('#btn-keep-existing');
  const conflictOwnerMsg = $<HTMLParagraphElement>('#conflict-owner-msg');
  const btnOwnerCancel = $<HTMLButtonElement>('#btn-owner-cancel');
  const btnOwnerConfirm = $<HTMLButtonElement>('#btn-owner-confirm');
  const conflictDialogIntro = $<HTMLParagraphElement>('#conflict-dialog-intro');
  const conflictIncomingSlot = $<HTMLDivElement>('#conflict-incoming-slot');
  const conflictIncomingRec = $<HTMLParagraphElement>('#conflict-incoming-rec');
  const conflictExistingSlot = $<HTMLDivElement>('#conflict-existing-slot');
  const conflictExistingRec = $<HTMLParagraphElement>('#conflict-existing-rec');

  function marksCount(marks: string): number {
    return [...marks].filter((c) => c !== '0').length;
  }

  function computeDefault(conflict: ConflictPayload): 'incoming' | 'existing' {
    const inc = conflict.incoming;
    const ex = conflict.existing;
    if (inc.groupId && !ex.groupId) return 'incoming';
    if (ex.groupId && !inc.groupId) return 'existing';
    // Both same context: more marks wins; tie goes to existing (the established card).
    return marksCount(inc.marks) > marksCount(ex.marks) ? 'incoming' : 'existing';
  }

  function conflictMarksLabel(marks: string): string {
    const n = [...marks].filter((c) => c !== '0').length;
    return `${n}/${SITUATION_COUNT} situaciones marcadas`;
  }

  function showConflictError(msg: string): void {
    conflictError.textContent = msg;
    conflictError.classList.remove('hidden');
  }

  function clearConflictError(): void {
    conflictError.textContent = '';
    conflictError.classList.add('hidden');
  }

  function setConflictBusy(busy: boolean): void {
    btnKeepIncoming.disabled = busy;
    btnKeepExisting.disabled = busy;
    btnOwnerConfirm.disabled = busy;
  }

  function populateConflictSlot(
    marksEl: HTMLParagraphElement,
    groupEl: HTMLParagraphElement,
    ownerEl: HTMLParagraphElement,
    card: ConflictCardInfo,
  ): void {
    marksEl.textContent = conflictMarksLabel(card.marks);
    groupEl.textContent = card.groupId ? `Grupo: ${card.groupName ?? card.groupId}` : 'Cartón individual';
    groupEl.classList.remove('hidden');
    ownerEl.classList.toggle('hidden', !card.isGroupOwner);
  }

  function showConflictDialog(
    conflict: ConflictPayload,
    incomingCardId: string,
    incomingSecret: string,
    mode: 'account' | 'local' = 'account',
    existingSecret: string | null = null,
    incomingCardState: CardState | null = null,
  ): void {
    const incHasGroup = !!conflict.incoming.groupId;
    const exHasGroup = !!conflict.existing.groupId;

    const dflt = computeDefault(conflict);
    conflictState = { incomingCardId, incomingSecret, conflict, pendingAction: null, default: dflt, mode, existingSecret, incomingCardState };
    clearConflictError();

    // Contextual intro copy
    if (incHasGroup && exHasGroup) {
      const exName = conflict.existing.groupName ?? conflict.existing.groupId;
      const incName = conflict.incoming.groupName ?? conflict.incoming.groupId;
      conflictDialogIntro.textContent = mode === 'local'
        ? `Tu cartón actual está en «${exName}» y el que recibes en «${incName}». Solo puedes estar activo en uno; el que elimines te sacará automáticamente de ese grupo.`
        : `Tu cuenta tiene un cartón en «${exName}» y otro en «${incName}». Solo puedes estar activo en uno; el que elimines te sacará automáticamente de ese grupo.`;
    } else if (incHasGroup !== exHasGroup) {
      const groupCard = incHasGroup ? conflict.incoming : conflict.existing;
      conflictDialogIntro.textContent =
        `El cartón de grupo «${groupCard.groupName ?? groupCard.groupId}» tiene prioridad sobre el cartón individual. Resolviendo automáticamente…`;
    } else {
      conflictDialogIntro.textContent = mode === 'local'
        ? 'Este dispositivo ya tiene un cartón activo. Elige cuál conservar; el otro se eliminará sin posibilidad de recuperación.'
        : 'Esta cuenta ya tiene un cartón activo. Elige cuál conservar; el otro se eliminará sin posibilidad de recuperación.';
    }

    populateConflictSlot(conflictIncomingMarks, conflictIncomingGroup, conflictIncomingOwner, conflict.incoming);
    populateConflictSlot(conflictExistingMarks, conflictExistingGroup, conflictExistingOwner, conflict.existing);

    // Highlight the recommended option
    conflictIncomingRec.classList.toggle('hidden', dflt !== 'incoming');
    conflictExistingRec.classList.toggle('hidden', dflt !== 'existing');
    conflictIncomingSlot.classList.toggle('border-green-500', dflt === 'incoming');
    conflictIncomingSlot.classList.toggle('border-paper-300', dflt !== 'incoming');
    conflictExistingSlot.classList.toggle('border-green-500', dflt === 'existing');
    conflictExistingSlot.classList.toggle('border-paper-300', dflt !== 'existing');

    conflictMain.classList.remove('hidden');
    conflictOwnerWarn.classList.add('hidden');
    conflictDialog.showModal();

    // Group beats solo: fire immediately. Dialog is already open so any failure is
    // visible and retryable; on success the page reloads before the user notices.
    if (incHasGroup !== exHasGroup) void acceptDefault();
  }

  function showOwnerConfirmation(discardingExisting: boolean): void {
    if (!conflictState) return;
    const card = discardingExisting
      ? conflictState.conflict.existing
      : conflictState.conflict.incoming;
    const groupName = card.groupName ?? card.groupId ?? 'este grupo';
    conflictOwnerMsg.textContent =
      `Este cartón es el administrador de «${groupName}». Al eliminarlo, la administración ` +
      `pasará automáticamente al miembro más veterano del grupo. Tendrás que pedir que te ` +
      `inviten de nuevo con un cartón nuevo si quieres volver.`;
    conflictMain.classList.add('hidden');
    conflictOwnerWarn.classList.remove('hidden');
    btnOwnerCancel.focus();
  }

  async function acceptDefault(): Promise<void> {
    if (!conflictState) return;
    if (conflictState.default === 'incoming') {
      if (conflictState.conflict.existing.isGroupOwner) {
        conflictState.pendingAction = 'keep-incoming';
        showOwnerConfirmation(true);
      } else {
        await resolveKeepIncoming();
      }
    } else {
      if (conflictState.conflict.incoming.isGroupOwner) {
        conflictState.pendingAction = 'keep-existing';
        showOwnerConfirmation(false);
      } else {
        await resolveKeepExisting();
      }
    }
  }

  async function resolveKeepIncoming(): Promise<void> {
    if (!conflictState) return;
    clearConflictError();
    setConflictBusy(true);
    const { incomingCardId, incomingSecret, conflict, mode } = conflictState;

    if (mode === 'local') {
      // No-account path: delete existing local card, save incoming, reload.
      const ok = await deleteCard(conflict.existing.cardId, conflictState.existingSecret!);
      if (!ok) {
        setConflictBusy(false);
        showConflictError('No se pudo eliminar el cartón anterior. Inténtalo de nuevo.');
        return;
      }
      if (conflictState.incomingCardState) saveCard(conflictState.incomingCardState);
      window.location.reload();
      return;
    }

    const del = await deleteAccountCard(conflict.existing.cardId);
    if (!del.ok) {
      setConflictBusy(false);
      showConflictError('No se pudo eliminar el cartón anterior. Inténtalo de nuevo.');
      return;
    }

    const link = await linkCard(incomingCardId, incomingSecret);
    if (!link.ok) {
      setConflictBusy(false);
      showConflictError('El cartón anterior se eliminó, pero no se pudo vincular este. Recarga la página.');
      return;
    }

    window.location.reload();
  }

  async function resolveKeepExisting(): Promise<void> {
    if (!conflictState) return;
    clearConflictError();
    setConflictBusy(true);
    const { incomingCardId, incomingSecret, mode } = conflictState;

    if (mode === 'local') {
      // No-account path: just close the dialog; existing card is already in play.
      setConflictBusy(false);
      conflictDialog.close();
      conflictState = null;
      return;
    }

    const ok = await deleteCard(incomingCardId, incomingSecret);
    if (!ok) {
      setConflictBusy(false);
      showConflictError('No se pudo resolver el conflicto. Inténtalo de nuevo.');
      return;
    }

    window.location.reload();
  }

  btnKeepIncoming.addEventListener('click', async () => {
    if (!conflictState) return;
    if (conflictState.conflict.existing.isGroupOwner) {
      conflictState.pendingAction = 'keep-incoming';
      showOwnerConfirmation(true);
    } else {
      await resolveKeepIncoming();
    }
  });

  btnKeepExisting.addEventListener('click', async () => {
    if (!conflictState) return;
    if (conflictState.conflict.incoming.isGroupOwner) {
      conflictState.pendingAction = 'keep-existing';
      showOwnerConfirmation(false);
    } else {
      await resolveKeepExisting();
    }
  });

  btnOwnerCancel.addEventListener('click', () => {
    if (!conflictState) return;
    conflictState.pendingAction = null;
    clearConflictError();
    conflictOwnerWarn.classList.add('hidden');
    conflictMain.classList.remove('hidden');
    btnKeepIncoming.focus();
  });

  btnOwnerConfirm.addEventListener('click', async () => {
    if (!conflictState?.pendingAction) return;
    if (conflictState.pendingAction === 'keep-incoming') {
      await resolveKeepIncoming();
    } else {
      await resolveKeepExisting();
    }
  });

  // Escape accepts the default option instead of dismissing unresolved.
  conflictDialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    void acceptDefault();
  });

  async function initAccountBar(): Promise<void> {
    if (!accountBar) return;
    const account = await fetchAccount();
    if (!account && !hasProviders) return;
    accountBar.classList.remove('hidden');
    accountBar.classList.add('flex');

    if (account) {
      const name = account.displayName ?? account.email ?? account.provider;
      if (accountLabel) accountLabel.textContent = `Cuenta: ${name}`;
      accountLoggedOut?.classList.add('hidden');
      accountLoggedOut?.classList.remove('flex');
      accountLoggedIn?.classList.remove('hidden');
      accountLoggedIn?.classList.add('flex');

      // Render profile sub-state.
      currentHandle = account.publicHandle ?? null;
      renderProfileControl(account.profilePublic && account.publicHandle ? 'active' : 'none', account.publicHandle);

      // Link the active localStorage card; show the conflict dialog if the account
      // already has a different active card (feature 10).
      const cards = loadCurrentCard() ? [loadCurrentCard()!] : [];
      for (const c of cards) {
        if (!c.id || !c.secret) continue;
        const result = await linkCard(c.id, c.secret);
        if (!result.ok && 'conflict' in result) {
          showConflictDialog(result.conflict, c.id, c.secret);
          return;
        }
      }
    } else {
      accountLoggedIn?.classList.add('hidden');
      accountLoggedIn?.classList.remove('flex');
      accountLoggedOut?.classList.remove('hidden');
      accountLoggedOut?.classList.add('flex');
    }
  }

  // Profile control event wiring
  btnCreateProfile?.addEventListener('click', () => renderProfileControl('form', currentHandle));
  btnEditProfile?.addEventListener('click', () => renderProfileControl('form', currentHandle));
  btnCancelProfile?.addEventListener('click', () =>
    renderProfileControl(currentHandle ? 'active' : 'none', currentHandle, true)
  );
  btnSaveProfile?.addEventListener('click', async () => {
    const handle = profileHandleInput?.value.trim().toLowerCase() ?? '';
    await saveProfile(handle, true);
  });
  profileHandleInput?.addEventListener('keydown', async (e) => {
    if (e.key === 'Enter') {
      const handle = profileHandleInput.value.trim().toLowerCase();
      await saveProfile(handle, true);
    }
  });
  btnDisableProfile?.addEventListener('click', async () => {
    if (!currentHandle) return;
    const result = await setProfile(currentHandle, false);
    if (result.ok) renderProfileControl('none', currentHandle, true);
  });

  btnLoginGoogle?.addEventListener('click', () => startLogin('google'));
  btnLoginX?.addEventListener('click', () => startLogin('x'));
  btnLogout?.addEventListener('click', async () => {
    await logout();
    window.location.reload();
  });

  btnDeleteAccount?.addEventListener('click', () => {
    if (deleteAccountError) {
      deleteAccountError.textContent = '';
      deleteAccountError.classList.add('hidden');
    }
    deleteAccountDialog?.showModal();
  });

  btnDeleteAccountCancel?.addEventListener('click', () => {
    deleteAccountDialog?.close();
  });

  deleteAccountDialog?.addEventListener('cancel', (e) => {
    e.preventDefault();
    deleteAccountDialog.close();
  });

  btnDeleteAccountConfirm?.addEventListener('click', async () => {
    if (btnDeleteAccountConfirm) btnDeleteAccountConfirm.disabled = true;
    const ok = await deleteAccount();
    if (ok) {
      clearCurrentCard();
      window.location.reload();
    } else {
      if (deleteAccountError) {
        deleteAccountError.textContent = 'No se pudo borrar. Inténtalo de nuevo.';
        deleteAccountError.classList.remove('hidden');
      }
      if (btnDeleteAccountConfirm) btnDeleteAccountConfirm.disabled = false;
    }
  });

  void initAccountBar();

  // -------------------------------------------------------------------------
  // Device-code cross-device transfer (feature 05-accounts P7)
  // -------------------------------------------------------------------------

  function renderDeviceCodeQr(code: string): void {
    if (!deviceCodeQr) return;
    const url = `${location.origin}/activar?code=${encodeURIComponent(code)}`;
    const qr = encodeQr(url, { ecc: 'M', border: 2 });
    const scale = 5;
    const size = qr.size * scale;
    let cells = '';
    for (let row = 0; row < qr.size; row++) {
      for (let col = 0; col < qr.size; col++) {
        if (qr.data[row]![col]) {
          cells += `<rect x="${col * scale}" y="${row * scale}" width="${scale}" height="${scale}" fill="currentColor"/>`;
        }
      }
    }
    deviceCodeQr.innerHTML =
      `<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}" class="text-paper-50" xmlns="http://www.w3.org/2000/svg">${cells}</svg>`;
  }

  let deviceCodeExpirerId: ReturnType<typeof setInterval> | null = null;

  function startExpiryCountdown(expiresIn: number): void {
    if (deviceCodeExpirerId) clearInterval(deviceCodeExpirerId);
    let remaining = expiresIn;
    function tick(): void {
      if (!deviceCodeExpiry) return;
      if (remaining <= 0) {
        deviceCodeExpiry.textContent = 'Código caducado. Genera uno nuevo.';
        if (deviceCodeExpirerId) clearInterval(deviceCodeExpirerId);
        return;
      }
      const m = Math.floor(remaining / 60);
      const s = String(remaining % 60).padStart(2, '0');
      deviceCodeExpiry.textContent = `Caduca en ${m}:${s}`;
      remaining--;
    }
    tick();
    deviceCodeExpirerId = setInterval(tick, 1000);
  }

  deviceCodeBtn?.addEventListener('click', async () => {
    const isOpen = deviceCodeBtn.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      deviceCodePanel?.classList.add('hidden');
      deviceCodeBtn.setAttribute('aria-expanded', 'false');
      if (deviceCodeExpirerId) clearInterval(deviceCodeExpirerId);
      return;
    }

    if (!card.id || !card.secret) return;

    if (deviceCodeError) deviceCodeError.classList.add('hidden');
    if (deviceCodeValue) deviceCodeValue.textContent = '…';
    deviceCodePanel?.classList.remove('hidden');
    deviceCodeBtn.setAttribute('aria-expanded', 'true');

    const result = await requestDeviceCode(card.id, card.secret);
    if (!result) {
      if (deviceCodeError) {
        deviceCodeError.textContent = 'No se pudo generar el código. Inténtalo de nuevo.';
        deviceCodeError.classList.remove('hidden');
      }
      if (deviceCodeValue) deviceCodeValue.textContent = '';
      return;
    }

    if (deviceCodeValue) deviceCodeValue.textContent = result.code;
    renderDeviceCodeQr(result.code);
    startExpiryCountdown(result.expiresIn);
  });
</script>
