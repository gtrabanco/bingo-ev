  const deviceCodeQr = $<HTMLDivElement>('#device-code-qr');
  const deviceCodeExpiry = $<HTMLParagraphElement>('#device-code-expiry');
  const deviceCodeError = $<HTMLParagraphElement>('#device-code-error');
  let galleryHidden = false;
