---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import BingoCard from '../components/BingoCard.astro';
import CertificateModal from '../components/CertificateModal.astro';

const hasGoogle = Boolean(env.GOOGLE_OAUTH_CLIENT_ID);
const hasX = Boolean(env.X_OAUTH_CLIENT_ID);
const hasAnyProvider = hasGoogle || hasX;
---

<Layout
  title="El Bingo del Cargador — Juego de bingo online sobre desgracias del cargador EV en España"
  description="Juega gratis al bingo del cargador eléctrico. Marca las desgracias típicas de la recarga pública en España, canta línea y bingo, y consigue tu diploma verificable."
>
  <main
    class="mx-auto flex min-h-dvh w-full max-w-md flex-col px-4 pt-7 pb-6 sm:max-w-lg sm:pt-12 lg:max-w-xl lg:pt-10"
  >
    <!-- Top navigation bar: Hall of Fame link (left) + device-transfer entry
         and account area (right). All controls are always in the DOM — JS
         shows/hides them based on card and session state. -->
    <nav class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-xs sm:text-sm" aria-label="Navegación principal">
      <a
        href="/hall-of-fame"
        class="text-paper-300/50 transition-colors hover:text-paper-300/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
      >Hall of Fame</a>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <!-- Device-transfer — hidden until a card exists (JS-controlled) -->
        <button
          id="device-code-btn"
          type="button"
          class="hidden text-paper-300/50 transition-colors hover:text-paper-300/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
          aria-expanded="false"
          aria-controls="device-code-panel"
        >Cambiar de dispositivo</button>

        <!-- Account / login (feature 05-accounts).
             Hidden until JS resolves session state to avoid layout flash. -->
        <div id="account-bar" data-has-providers={hasAnyProvider ? 'true' : 'false'} class="items-center gap-2 hidden" aria-live="polite">
          {hasAnyProvider && (
            <div id="account-loggedout" class="hidden items-center gap-2">
              <span class="text-paper-300/60">Guardar mis diplomas:</span>
              {hasGoogle && (
                <button
                  id="btn-login-google"
                  type="button"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-paper-50/25 bg-felt-950/40 px-2.5 py-1 font-semibold text-paper-50 transition-colors hover:bg-paper-50/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
                  aria-label="Continuar con Google"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                  </svg>
                  Google
                </button>
              )}
              {hasX && (
                <button
                  id="btn-login-x"
                  type="button"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-paper-50/25 bg-felt-950/40 px-2.5 py-1 font-semibold text-paper-50 transition-colors hover:bg-paper-50/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
                  aria-label="Continuar con X"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                  X
                </button>
              )}
            </div>
          )}
          <!-- Logged-in state -->
          <div id="account-loggedin" class="hidden flex-wrap items-center gap-2">
            <span id="account-label" class="text-paper-300/75"></span>
            <span class="text-paper-300/30" aria-hidden="true">·</span>
            <!-- Public profile control (feature 09) — three sub-states toggled by JS -->
            <div id="profile-ctl" class="flex flex-wrap items-center gap-1.5">
              <!-- no profile yet -->
              <div id="profile-none">
                <button
                  id="btn-create-profile"
                  type="button"
                  class="underline decoration-paper-300/40 underline-offset-2 transition-colors hover:text-paper-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
                >Perfil público</button>
              </div>
              <!-- profile active -->
              <div id="profile-active" class="hidden items-center gap-1.5">
                <a
                  id="profile-link"
                  href=""
                  class="font-semibold text-amber-300/80 transition-colors hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
                ></a>
                <button
                  id="btn-edit-profile"
                  type="button"
                  class="underline decoration-paper-300/40 underline-offset-2 transition-colors hover:text-paper-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
                >editar</button>
                <button
                  id="btn-disable-profile"
                  type="button"
                  class="underline decoration-paper-300/40 underline-offset-2 transition-colors hover:text-paper-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
                >desactivar</button>
              </div>
              <!-- create / edit form -->
              <div id="profile-form-wrap" class="hidden flex-wrap items-center gap-1.5">
                <label for="profile-handle-input" class="sr-only">Nombre de perfil público (letras minúsculas, números y guiones, 3–24 caracteres)</label>
                <input
                  id="profile-handle-input"
                  type="text"
                  placeholder="mi-handle"
                  maxlength="24"
                  autocomplete="off"
                  autocapitalize="none"
                  spellcheck="false"
                  class="w-28 rounded border border-paper-300/25 bg-felt-950/60 px-2 py-0.5 text-xs text-paper-50 placeholder-paper-300/40 focus:outline-none focus:ring-1 focus:ring-amber-300/50"
                  aria-describedby="profile-error"
                />
                <button
                  id="btn-save-profile"
                  type="button"
                  class="rounded border border-amber-300/30 bg-felt-800/40 px-2 py-0.5 text-xs text-amber-300 transition-colors hover:bg-felt-800/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
                >Activar</button>
                <button
                  id="btn-cancel-profile"
                  type="button"
                  class="underline decoration-paper-300/40 underline-offset-2 transition-colors hover:text-paper-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
                >cancelar</button>
                <p id="profile-error" aria-live="polite" class="hidden w-full text-xs text-red-300"></p>
              </div>
            </div>
            <span class="text-paper-300/30" aria-hidden="true">·</span>
            <button
              id="btn-logout"
              type="button"
              class="underline decoration-paper-300/40 underline-offset-2 transition-colors hover:text-paper-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
            >Cerrar sesión</button>
            <span class="text-paper-300/30" aria-hidden="true">·</span>
            <button
              id="btn-delete-account"
              type="button"
              class="underline decoration-red-300/40 underline-offset-2 text-red-300/80 transition-colors hover:text-red-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
            >Borrar todo</button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Delete-account confirmation dialog -->
    <dialog
      id="delete-account-dialog"
      class="rounded-2xl border border-paper-50/15 bg-felt-900 p-6 text-paper-50 shadow-2xl backdrop:bg-felt-950/80 max-w-sm w-full mx-auto"
      aria-labelledby="delete-account-title"
    >
      <h2 id="delete-account-title" class="text-lg font-black uppercase tracking-tight text-red-400">
        ¿Borrar todo, de verdad?
      </h2>
      <p class="mt-3 text-sm/relaxed text-paper-300/80">
        Esto borra tu cuenta, tus cartones y también tus diplomas.
        No quedará nada que verificar ni que presumir.
        No hay vuelta atrás.
      </p>
      <p id="delete-account-error" class="hidden mt-2 text-sm text-red-300" aria-live="polite"></p>
      <div class="mt-5 flex justify-end gap-3">
        <button
          id="btn-delete-account-cancel"
          type="button"
          autofocus
          class="rounded-xl border border-paper-50/20 bg-felt-800/40 px-4 py-2 text-sm font-semibold text-paper-50 transition-colors hover:bg-felt-800/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-300"
        >Mejor no</button>
        <button
          id="btn-delete-account-confirm"
          type="button"
          class="rounded-xl border border-red-400/40 bg-red-900/30 px-4 py-2 text-sm font-semibold text-red-400 transition-colors hover:bg-red-900/60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-red-400"
        >Sí, bórralo todo</button>
      </div>
    </dialog>

    <!-- Device-code panel: shown directly below the navbar when the button is clicked -->
    <div
      id="device-code-panel"
      class="hidden mt-3 rounded-xl border border-paper-50/15 bg-felt-950/40 p-4 text-center space-y-3"
      role="region"
      aria-label="Código para otro dispositivo"
    >
      <p class="text-xs text-paper-300/70">
        En el otro dispositivo ve a <strong class="text-paper-50">bingo.gruxon.com/activar</strong>
        e introduce este código, o escanea el QR.
      </p>
      <p
        id="device-code-value"
        class="text-3xl font-black tracking-[0.25em] text-amber-300"
        aria-live="polite"
      ></p>
      <div id="device-code-qr" class="flex justify-center" aria-hidden="true"></div>
      <p id="device-code-expiry" class="text-[0.6875rem] text-paper-300/50"></p>
      <p id="device-code-error" class="hidden text-xs text-red-300"></p>
    </div>

    <!-- Brand eyebrow — compact until SiteNav lands (S3); H1 kept for SEO. -->
    <header class="mt-5 text-center">
      <p class="text-[0.5625rem] font-bold uppercase tracking-[0.4em] text-amber-300/60 sm:text-[0.625rem]">
        Gran sorteo nacional de la recarga
      </p>
      <h1 class="mt-1 text-sm font-black uppercase tracking-[0.3em] text-paper-300/50 sm:text-base">
        El Bingo del Cargador
      </h1>
    </header>

    <section
      class="mt-5 flex items-center justify-between gap-3 rounded-xl border border-paper-50/15 bg-felt-950/40 px-4 py-2.5 text-sm sm:text-base"
      aria-live="polite"
    >
      <p id="status-marks" class="shrink-0 font-bold">0/6 desgracias</p>
      <p id="status-lines" class="text-right text-paper-300/85">Sin líneas. De momento.</p>
    </section>

    <div class="mt-3 flex justify-center">
      <div
        class="inline-flex rounded-xl border border-paper-50/20 bg-felt-950/40 p-1 text-[0.625rem] font-bold uppercase tracking-wider sm:text-xs"
        role="group"
        aria-label="Modo de marcado"
      >
        <button id="mode-sin" type="button" class="mode-btn rounded-lg px-2.5 py-1.5 sm:px-3">
          Sinvergüenza
        </button>
        <button id="mode-mix" type="button" class="mode-btn rounded-lg px-2.5 py-1.5 sm:px-3">
          Mixto
        </button>
        <button id="mode-ev" type="button" class="mode-btn rounded-lg px-2.5 py-1.5 sm:px-3">
          Resignado EV
        </button>
      </div>
    </div>
    <p
      id="mode-hint"
      class="mt-1.5 text-center text-[0.625rem]/snug text-paper-300/60 sm:text-[0.6875rem]/snug"
      aria-live="polite"
    >
    </p>

    <!-- Player alias: a display label for standings and shared views, never an
         identity. It lives above the card so it's clearly group-independent.
         Shown as text + edit button once set; as an input until then. -->
    <div class="mt-3">
      <p id="alias-display" class="hidden text-center text-xs text-paper-300/75 sm:text-sm">
        Juegas como <strong id="alias-label" class="text-amber-200"></strong>
        <button
          id="alias-edit"
          type="button"
          class="ml-1 underline decoration-paper-300/40 underline-offset-2 transition-colors hover:text-paper-50"
        >editar</button>
      </p>
      <form id="alias-form" class="mx-auto hidden w-full max-w-xs space-y-2">
        <div class="flex items-center gap-2">
          <input
            id="alias-input"
            type="text"
            required
            maxlength="32"
            placeholder="Tu alias (se verá en los grupos)"
            autocomplete="nickname"
            class="min-w-0 flex-1 rounded-lg border-2 border-paper-50/25 bg-felt-950/60 px-3 py-2 text-sm text-paper-50 outline-none placeholder:text-paper-300/40 focus:border-amber-300 sm:text-base"
          />
          <button
            type="submit"
            class="shrink-0 rounded-lg border-2 border-paper-50/30 px-3 py-2 text-xs font-black uppercase tracking-widest transition-colors hover:bg-paper-50/10 sm:text-sm"
          >
            Guardar
          </button>
        </div>
        <div id="vehicle-type-row">
          <select
            id="vehicle-type-select"
            aria-label="Tipo de vehículo (opcional)"
            class="w-full rounded-lg border-2 border-paper-50/25 bg-felt-950/60 px-3 py-2 text-sm text-paper-50 outline-none focus:border-amber-300 sm:text-base"
          >
            <option value="">Prefiero no decirlo</option>
            <optgroup label="Eléctrico puro (BEV)">
              <option value="bev_tesla">Tesla</option>
              <option value="bev_renault">Renault</option>
              <option value="bev_vw">Volkswagen</option>
              <option value="bev_hyundai">Hyundai</option>
              <option value="bev_kia">Kia</option>
              <option value="bev_byd">BYD</option>
              <option value="bev_cupra">SEAT / Cupra</option>
              <option value="bev_peugeot">Peugeot / Citroën / Opel</option>
              <option value="bev_nissan">Nissan</option>
              <option value="bev_bmw">BMW / MINI</option>
              <option value="bev_audi">Audi</option>
              <option value="bev_mercedes">Mercedes</option>
              <option value="bev_volvo">Volvo</option>
              <option value="bev_other">Otra marca eléctrica</option>
            </optgroup>
            <option value="phev">Híbrido enchufable (PHEV)</option>
            <option value="ice">Combustión / No uso VE</option>
          </select>
        </div>
      </form>
    </div>

    <div class="mt-3" id="card-container">
      <BingoCard />
    </div>
    <p class="mt-1.5 text-center text-[0.625rem]/snug text-paper-300/55 sm:text-[0.6875rem]/snug landscape:hidden">
      En vertical, el cartón va girado: las líneas corren de arriba abajo.
    </p>

    <button
      id="show-cert"
      type="button"
      class="mt-4 hidden w-full rounded-xl bg-amber-300 px-4 py-3 text-sm font-black uppercase tracking-widest text-felt-950 shadow-[0_6px_0_rgb(0_0_0/0.3)] transition-all active:translate-y-0.5 active:shadow-none sm:text-base"
    >
      Tu diploma
    </button>

    <button
      id="share-card"
      type="button"
      class="mt-4 hidden w-full rounded-xl border-2 border-paper-50/30 px-4 py-2.5 text-xs font-black uppercase tracking-widest transition-colors hover:bg-paper-50/10 active:bg-paper-50/15 sm:text-sm"
    >
      Compartir cómo voy
    </button>

    <button
      id="gallery-toggle"
      type="button"
      aria-pressed="false"
      class="mt-2 hidden w-full rounded-xl border border-paper-300/20 px-4 py-2 text-xs text-paper-300/60 transition-colors hover:border-paper-300/35 hover:text-paper-300/80"
    >
      Ocultar de la galería pública
    </button>

    <noscript>
      <p
        class="mt-4 rounded-xl border border-amber-300/40 bg-amber-300/10 px-4 py-3 text-center text-sm text-amber-200"
      >
        Esto necesita JavaScript activado. Como los cargadores, pero de verdad.
      </p>
    </noscript>

      <button
        id="new-card"
        type="button"
        class="mt-8 w-full rounded-xl border-2 border-paper-50/30 px-4 py-3 text-sm font-black uppercase tracking-widest transition-colors hover:bg-paper-50/10 active:bg-paper-50/15 sm:text-base lg:mt-4"
      >
        Regenerar cartón
      </button>

    <details class="mt-4 rounded-xl border border-paper-50/15 bg-felt-950/40 px-4 py-3 lg:mt-5">
        <summary
          class="cursor-pointer list-none text-xs font-bold uppercase tracking-widest text-paper-300/80 sm:text-sm"
        >
          Guarda o recupera tus cartones
        </summary>

        <div class="mt-3">
          <p class="text-[0.6875rem]/relaxed text-paper-300/70 sm:text-xs/relaxed">
            Vincula un correo a este cartón y podrás recuperarlo en otro dispositivo. Sin
            contraseñas: te llegará un enlace al email.
          </p>
          <form id="email-form" class="mt-2 flex flex-col gap-2">
            <input
              id="email-input"
              type="email"
              required
              placeholder="tu@correo.es"
              autocomplete="email"
              class="w-full rounded-lg border-2 border-paper-50/25 bg-felt-950/60 px-3 py-2 text-sm text-paper-50 outline-none placeholder:text-paper-300/40 focus:border-amber-300 sm:text-base"
            />
            <label class="flex items-start gap-2 text-[0.6875rem]/snug text-paper-300/70 sm:text-xs/snug">
              <input id="newsletter-check" type="checkbox" class="mt-0.5 shrink-0" />
              <span>
                Apúntame a la newsletter de
                <a
                  href="https://gtrabanco.com"
                  target="_blank"
                  rel="noopener"
                  class="underline decoration-paper-300/40">Gabriel Trabanco</a
                >. Sin agobios.
              </span>
            </label>
            <button
              id="email-submit"
              type="submit"
              class="rounded-lg bg-amber-300 px-4 py-2 text-xs font-black uppercase tracking-widest text-felt-950 transition-colors active:bg-amber-400 sm:text-sm"
            >
              Vincular este cartón
            </button>
            <p class="text-[0.625rem]/snug text-paper-300/55 sm:text-[0.6875rem]/snug">
              Responsable: Gabriel Trabanco. Usamos tu correo solo para reenviarte tus cartones
              (y, si lo marcas, para la newsletter). No lo vendemos ni cedemos. Puedes borrarlo
              cuando quieras. Más en la
              <a href="/privacidad" class="underline decoration-paper-300/40 hover:text-paper-50"
                >política de privacidad</a
              >.
            </p>
          </form>

          <hr class="my-3 border-paper-50/10" />

          <p class="text-[0.6875rem]/relaxed text-paper-300/70 sm:text-xs/relaxed">
            ¿Ya tenías cartones guardados? Te reenviamos los enlaces.
          </p>
          <form id="recover-form" class="mt-2 flex gap-2">
            <input
              id="recover-input"
              type="email"
              required
              placeholder="tu@correo.es"
              autocomplete="email"
              class="min-w-0 flex-1 rounded-lg border-2 border-paper-50/25 bg-felt-950/60 px-3 py-2 text-sm text-paper-50 outline-none placeholder:text-paper-300/40 focus:border-amber-300 sm:text-base"
            />
            <button
              id="recover-submit"
              type="submit"
              class="shrink-0 rounded-lg border-2 border-paper-50/30 px-4 py-2 text-xs font-black uppercase tracking-widest transition-colors hover:bg-paper-50/10 sm:text-sm"
            >
              Recuperar
            </button>
          </form>
          <p id="email-hint" class="mt-2 min-h-4 text-[0.6875rem]/snug text-amber-200/90 sm:text-xs/snug" aria-live="polite"></p>
        </div>
      </details>

      <details class="mt-4 rounded-xl border border-paper-50/15 bg-felt-950/40 px-4 py-3">
        <summary
          class="cursor-pointer list-none text-xs font-bold uppercase tracking-widest text-paper-300/80 sm:text-sm"
        >
          Grupos de bingo
        </summary>
        <div class="mt-3">
          <!-- Shown instead of the create form when the current card already
               plays in a group: one card, one group. A fresh cartón resets it. -->
          <div id="group-current" class="hidden">
            <p class="text-[0.6875rem]/relaxed text-paper-300/70 sm:text-xs/relaxed">
              Tu cartón ya juega en un grupo. Un cartón, un grupo: para crear o entrar en
              otro, regenera el cartón.
            </p>
            <a
              id="group-link"
              href="/"
              class="mt-2 block rounded-lg bg-amber-300 px-4 py-2 text-center text-xs font-black uppercase tracking-widest text-felt-950 transition-colors active:bg-amber-400 sm:text-sm"
            >
              Ver mi grupo y su ranking
            </a>
          </div>

          <div id="group-create">
          <p class="text-[0.6875rem]/relaxed text-paper-300/70 sm:text-xs/relaxed">
            Crea un grupo, comparte el enlace y que cada cual juegue su cartón. Solo el primero
            en completar canta bingo. Los demás, a aplaudir.
          </p>
          <form id="group-form" class="mt-2 flex flex-col gap-2">
            <input
              id="group-name"
              type="text"
              required
              maxlength="40"
              placeholder="Nombre del grupo (único)"
              autocomplete="off"
              class="w-full rounded-lg border-2 border-paper-50/25 bg-felt-950/60 px-3 py-2 text-sm text-paper-50 outline-none placeholder:text-paper-300/40 focus:border-amber-300 sm:text-base"
            />
            <fieldset class="mt-1">
              <legend class="text-[0.625rem] font-bold uppercase tracking-wide text-paper-300/60 sm:text-[0.6875rem]">
                ¿Quién puede unirse?
              </legend>
              <label class="mt-1 flex items-center gap-2 text-[0.6875rem]/snug text-paper-300/80 sm:text-xs/snug">
                <input type="radio" name="group-join" value="open" class="shrink-0" checked />
                <span>Cualquiera con el enlace</span>
              </label>
              <label class="mt-1 flex items-center gap-2 text-[0.6875rem]/snug text-paper-300/80 sm:text-xs/snug">
                <input type="radio" name="group-join" value="password" class="shrink-0" />
                <span>Solo con contraseña</span>
              </label>
            </fieldset>
            <input
              id="group-password"
              type="text"
              maxlength="64"
              placeholder="Contraseña del grupo"
              autocomplete="off"
