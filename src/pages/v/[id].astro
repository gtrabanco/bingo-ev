---
// Public verification page: /v/<cardId>. Server-rendered against D1.
// Three outcomes: verified completion, card still in play, or no record.
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { CELL_COUNT, expiryFromCreatedAt, getSituation, unpackMarks } from '../../lib/card';
import CardFrame from '../../components/CardFrame.astro';

interface CardRow {
  id: string;
  created_at: string;
  completed_at: string | null;
  nick: string | null;
  cells: string | null;
  marks: string | null;
}

const ID_PATTERN = /^[0-9a-z]{8}$/;
const id = Astro.params.id ?? '';

let row: CardRow | null = null;
let ogImage = '/og/home.svg';
let ogImageType = 'image/svg+xml';
if (ID_PATTERN.test(id)) {
  row = await env.DB.prepare('SELECT id, created_at, completed_at, nick, cells, marks FROM cards WHERE id = ?1')
    .bind(id)
    .first<CardRow>();
}

// A pending card past its window is as good as gone: delete it lazily and
// report "no record", same as the API would.
if (row && !row.completed_at && Date.now() > expiryFromCreatedAt(row.created_at).getTime()) {
  await env.DB.prepare('DELETE FROM cards WHERE id = ?1').bind(id).run();
  row = null;
}

const verdict: 'verified' | 'pending' | 'unknown' = row
  ? row.completed_at
    ? 'verified'
    : 'pending'
  : 'unknown';

// OG image for completed cards
if (row?.completed_at) {
  ogImage = `/og/diploma/${id}.png`;
  ogImageType = 'image/png';
}

// Parse card cells and marks for the verified view (null-safe: old cards lack this data).
let cells: (string | null)[] | null = null;
if (row?.cells) {
  try {
    const parsed: unknown = JSON.parse(row.cells);
    if (Array.isArray(parsed) && parsed.length === CELL_COUNT) {
      cells = parsed.map((c) => (typeof c === 'string' ? c : null));
    }
  } catch {
    cells = null;
  }
}
const marks = row?.marks && row.marks.length === CELL_COUNT ? unpackMarks(row.marks) : Array(CELL_COUNT).fill(0);

const longDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

Astro.response.headers.set('cache-control', 'no-store');

const titles = {
  verified: 'Bingo verificado',
  pending: 'Cartón en juego',
  unknown: 'Este cartón no consta',
} as const;
---

<Layout
  title={`${titles[verdict]} — El Bingo del Cargador`}
  description="Verificación oficiosa de cartones del Bingo del Cargador."
  ogImage={ogImage}
  ogImageType={ogImageType}
>
  <main class="mx-auto flex flex-1 w-full max-w-md flex-col px-4 pt-10 pb-6">
    <p
      class="text-center text-[0.625rem] font-bold uppercase tracking-[0.4em] text-amber-300/80 sm:text-xs"
    >
      Registro oficioso de cartones
    </p>

    <CardFrame class="mt-5" footerCenter={true}>
      <p slot="header-left" class="font-mono text-[0.625rem] tracking-wider uppercase sm:text-xs">
        Cartón nº <span class="font-bold">{ID_PATTERN.test(id) ? id : '????????'}</span>
      </p>
      <p slot="header-right" class="shrink-0 text-[0.625rem] font-bold uppercase tracking-[0.2em] text-paper-50 sm:text-xs">
        Acta
      </p>

      <div class="px-5 py-6 text-center">
        {
          verdict === 'verified' && row && (
            <>
              <p class="inline-block -rotate-3 rounded-lg border-4 border-double border-felt-800 px-4 py-1.5 text-2xl font-black uppercase tracking-[0.25em] text-felt-800">
                Verificado
              </p>
              <p class="mt-5 text-sm/relaxed text-ink-900/80 sm:text-base/relaxed">
                <strong>{row.nick ?? 'Alguien con mucha paciencia'}</strong> completó este cartón
                el <strong>{longDate.format(new Date(row.completed_at!))}</strong>, dentro del
                plazo reglamentario de un mes.
              </p>
              <p class="mt-3 text-xs text-ink-900/55 sm:text-sm">
                Registrado el {longDate.format(new Date(row.created_at))}. La organización da fe.
                Hasta donde la organización puede dar fe de algo.
              </p>
            </>
          )
        }
        {
          verdict === 'pending' && row && (
            <>
              <p class="inline-block -rotate-3 rounded-lg border-4 border-double border-amber-600 px-4 py-1.5 text-2xl font-black uppercase tracking-[0.25em] text-amber-600">
                En juego
              </p>
              <p class="mt-5 text-sm/relaxed text-ink-900/80 sm:text-base/relaxed">
                Cartón registrado el <strong>{longDate.format(new Date(row.created_at))}</strong>,
                aún sin completar.
              </p>
              <p class="mt-3 text-xs text-ink-900/55 sm:text-sm">
                Tiene hasta el {longDate.format(expiryFromCreatedAt(row.created_at))} para
                cantar bingo. Las desgracias, por desgracia, llegarán solas.
              </p>
              <p class="mt-3 text-xs sm:text-sm">
                <a href={`/c/${row.id}`} class="font-bold underline decoration-ink-900/30 underline-offset-2">
                  Ver el cartón en directo
                </a>
              </p>
            </>
          )
        }
        {
          verdict === 'unknown' && (
            <>
              <p class="inline-block -rotate-3 rounded-lg border-4 border-double border-dauber-600 px-4 py-1.5 text-2xl font-black uppercase tracking-[0.25em] text-dauber-600">
                No consta
              </p>
              <p class="mt-5 text-sm/relaxed text-ink-900/80 sm:text-base/relaxed">
                Este cartón no figura en el registro. O nunca existió, o caducó sin gloria.
              </p>
              <p class="mt-3 text-xs text-ink-900/55 sm:text-sm">
                El registro no guarda rencor: los cartones caducados se eliminan.
              </p>
            </>
          )
        }
      </div>

      <Fragment slot="footer">Verificación sin validez legal, técnica ni emocional</Fragment>
    </CardFrame>

    {
      verdict === 'verified' && cells && (
        <CardFrame class="mt-4 w-full">
          <p slot="header-left" class="font-mono text-[0.625rem] tracking-wider uppercase sm:text-xs">
            Cartón nº <span class="font-bold">{id}</span>
          </p>
          <p slot="header-right" class="shrink-0 text-[0.625rem] font-bold uppercase tracking-[0.2em] text-paper-50 sm:text-xs">
            Completado
          </p>
          <div
            class="grid grid-flow-col grid-cols-3 grid-rows-4 gap-px bg-ink-900 landscape:grid-flow-row landscape:grid-cols-4 landscape:grid-rows-3"
          >
            {
              cells.map((situationId, index) =>
                situationId === null ? (
                  <div class="cell cell-blank" aria-hidden="true" />
                ) : (
                  <div
                    class="cell"
                    role="img"
                    aria-label={`${getSituation(situationId)?.text ?? '—'} — ${marks[index] === 2 ? 'causada' : marks[index] === 1 ? 'sufrida' : 'sin marcar'}`}
                    data-kind={String(marks[index] ?? 0)}
                    style={`--dab-rot: ${((index * 53) % 19) - 9}deg`}
                  >
                    <span class="cell-text" aria-hidden="true">{getSituation(situationId)?.text ?? '—'}</span>
                    <span class="dab" aria-hidden="true" />
                  </div>
                )
              )
            }
          </div>
          <span slot="footer">Cada casilla marcada, una desgracia vivida</span>
          <span slot="footer" class="shrink-0">Bingo cantado</span>
        </CardFrame>
      )
    }

    <a
      href="/"
      class="mt-6 rounded-xl border-2 border-paper-50/30 px-4 py-3 text-center text-sm font-black uppercase tracking-widest text-paper-50 transition-colors hover:bg-paper-50/10"
    >
      Jugar mi propio cartón
    </a>

    <footer class="mt-auto pt-8 text-center text-[0.6875rem]/relaxed text-paper-300/55 sm:text-sm/relaxed">
      <p class="font-semibold">bingo.gruxon.com · Hecho con resignación · 2026</p>
      <div class="mt-2 flex items-center justify-center gap-4">
        <a href="https://gtrabanco.com" target="_blank" rel="noopener" aria-label="Web de Gabriel Trabanco" class="transition-colors hover:text-paper-50"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></a>
        <a href="https://x.com/GabrielTrabanco" target="_blank" rel="noopener" aria-label="@GabrielTrabanco en X" class="transition-colors hover:text-paper-50"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
        <a href="https://github.com/gtrabanco/bingo-ev" target="_blank" rel="noopener" aria-label="Código en GitHub" class="transition-colors hover:text-paper-50"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></a>
      </div>
      <p class="mt-1.5">
        Creado por
        <a href="https://gtrabanco.com" target="_blank" rel="noopener" class="underline decoration-paper-300/40 underline-offset-2 transition-colors hover:text-paper-50">Gabriel Trabanco</a>
      </p>
    </footer>
  </main>
</Layout>
