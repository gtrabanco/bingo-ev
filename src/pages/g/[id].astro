---
// Bingo group page: /g/<groupId>. Public standings; only ONE member wins —
// the first to complete their card. Joining requires an alias and the
// visitor's own card (its owner secret never leaves their browser; the join
// call sends it same-origin only). Password-protected groups also ask for the
// password, and private groups only reveal the standings to members (fetched
// client-side with the membership secret).
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { CELL_COUNT, SITUATION_COUNT } from '../../lib/card';

interface GroupRow {
  id: string;
  name: string;
  created_at: string;
  winner_card_id: string | null;
  join_policy: string;
  public_board: number;
  owner_card_id: string | null;
}

interface MemberRow {
  id: string;
  alias: string | null;
  nick: string | null;
  marks: string | null;
  completed_at: string | null;
}

const ID_PATTERN = /^[0-9a-z]{8}$/;
const id = Astro.params.id ?? '';

let group: GroupRow | null = null;
let members: MemberRow[] = [];
if (ID_PATTERN.test(id)) {
  group = await env.DB.prepare(
    'SELECT id, name, created_at, winner_card_id, join_policy, public_board, owner_card_id FROM groups WHERE id = ?1',
  )
    .bind(id)
    .first<GroupRow>();
  // Only public boards expose their standings server-side. Private ones are
  // fetched client-side once the visitor proves membership.
  if (group && group.public_board) {
    const rows = await env.DB.prepare(
      'SELECT id, alias, nick, marks, completed_at FROM cards WHERE group_id = ?1',
    )
      .bind(id)
      .all<MemberRow>();
    members = rows.results ?? [];
  }
}

const isPublic = group?.public_board === 1;
const isPasswordProtected = group?.join_policy === 'password';

function nameOf(member: MemberRow): string {
  return member.alias ?? member.nick ?? `Cartón nº ${member.id}`;
}

function markedOf(member: MemberRow): number {
  if (!member.marks || member.marks.length !== CELL_COUNT) return 0;
  return [...member.marks].filter((digit) => digit !== '0').length;
}

const winnerId = group?.winner_card_id ?? null;
const standings = [...members].sort((a, b) => {
  if (a.id === winnerId) return -1;
  if (b.id === winnerId) return 1;
  return markedOf(b) - markedOf(a);
});
const winner = members.find((member) => member.id === winnerId) ?? null;

const longDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

Astro.response.headers.set('cache-control', 'no-store');
---

<Layout
  title={group ? `Grupo «${group.name}» — El Bingo del Cargador` : 'Grupo no encontrado — El Bingo del Cargador'}
  description="Grupo de bingo del cargador: varios cartones, un solo ganador. El primero que complete, canta."
>
  <main class="mx-auto flex min-h-dvh w-full max-w-md flex-col px-4 pt-10 pb-6 sm:max-w-lg">
    <p
      class="text-center text-[0.625rem] font-bold uppercase tracking-[0.4em] text-amber-300/80 sm:text-xs"
    >
      Grupo de bingo · Solo uno canta
    </p>

    {
      group ? (
        <>
          <h1 class="mt-2 text-center text-3xl font-black uppercase tracking-tight text-balance text-amber-300 drop-shadow-[0_3px_0_rgb(0_0_0/0.45)] sm:text-4xl">
            {group.name}
          </h1>

          {isPublic ? (
            <>
              {winner ? (
                <p class="mt-4 rounded-xl border-2 border-amber-300/60 bg-amber-300/10 px-4 py-3 text-center text-sm/relaxed text-paper-50 sm:text-base/relaxed">
                  ¡BINGO! Cantado por <strong>{nameOf(winner)}</strong> el{' '}
                  {longDate.format(new Date(winner.completed_at!))}. El resto: a seguir sufriendo,
                  pero ya sin premio.
                </p>
              ) : (
                <p class="mt-4 text-center text-sm/relaxed text-paper-300/85 sm:text-base/relaxed">
                  Aún sin ganador. El primero que complete su cartón se lo lleva. Los demás se
                  llevan las desgracias, que también es algo.
                </p>
              )}

              <section class="mt-5 overflow-hidden rounded-2xl border-4 border-ink-900 bg-paper-50 text-ink-900 shadow-[0_18px_40px_-12px_rgb(0_0_0/0.55)]">
                <header class="flex items-baseline justify-between gap-3 border-b-4 border-ink-900 bg-dauber-600 px-3.5 py-2 text-paper-50">
                  <p class="text-lg font-black uppercase tracking-[0.35em] sm:text-xl">Sala</p>
                  <p class="shrink-0 font-mono text-[0.625rem] tracking-wider uppercase sm:text-xs">
                    Grupo nº {group.id}
                  </p>
                </header>

                {standings.length === 0 ? (
                  <p class="px-4 py-6 text-center text-sm text-ink-900/70 sm:text-base">
                    Todavía no hay cartones en la sala. Sé quien reparta las desgracias.
                  </p>
                ) : (
                  <ul class="divide-y divide-ink-900/15">
                    {standings.map((member) => (
                      <li
                        class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm sm:text-base"
                        data-member-card={member.id}
                      >
                        <span class="min-w-0 truncate">
                          {member.id === winnerId && <span aria-hidden="true">🏆 </span>}
                          <strong>{nameOf(member)}</strong>
                          <span class="member-you hidden text-ink-900/55"> (tú)</span>
                        </span>
                        <span class="member-actions flex shrink-0 items-center gap-2">
                          <a
                            href={`/c/${member.id}`}
                            class="text-[0.6875rem] underline decoration-ink-900/30 underline-offset-2 sm:text-xs"
                          >
                            ver
                          </a>
                          <span class="font-mono font-bold">
                            {member.completed_at ? 'BINGO' : `${markedOf(member)}/${SITUATION_COUNT}`}
                          </span>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            </>
          ) : (
            <section
              id="private-board"
              class="mt-5 overflow-hidden rounded-2xl border-4 border-ink-900 bg-paper-50 text-ink-900 shadow-[0_18px_40px_-12px_rgb(0_0_0/0.55)]"
            >
              <header class="flex items-baseline justify-between gap-3 border-b-4 border-ink-900 bg-dauber-600 px-3.5 py-2 text-paper-50">
                <p class="text-lg font-black uppercase tracking-[0.35em] sm:text-xl">Sala</p>
                <p class="shrink-0 font-mono text-[0.625rem] tracking-wider uppercase sm:text-xs">
                  Grupo nº {group.id}
                </p>
              </header>
              <p
                id="private-notice"
                class="px-4 py-6 text-center text-sm text-ink-900/70 sm:text-base"
              >
                El estado de este grupo es privado. Únete con tu cartón para ver a los demás.
              </p>
            </section>
          )}

          <form id="join-form" class="mt-5 flex flex-col gap-2">
            <p
              id="join-alias-display"
              class="hidden text-center text-xs text-paper-300/75 sm:text-sm"
            >
              Entrarás como <strong id="join-alias-label" class="text-amber-200"></strong>
              <button
                id="join-alias-edit"
                type="button"
                class="ml-1 underline decoration-paper-300/40 underline-offset-2 transition-colors hover:text-paper-50"
              >cambiar</button>
            </p>
            <input
              id="join-alias"
              type="text"
              required
              maxlength="32"
              placeholder="Tu alias (se verá en la sala)"
              autocomplete="nickname"
              class="w-full rounded-lg border-2 border-paper-50/25 bg-felt-950/60 px-3 py-2 text-sm text-paper-50 outline-none placeholder:text-paper-300/40 focus:border-amber-300 sm:text-base"
            />
            {isPasswordProtected && (
              <input
                id="join-password"
                type="text"
                maxlength="64"
                placeholder="Contraseña del grupo"
                autocomplete="off"
                class="w-full rounded-lg border-2 border-paper-50/25 bg-felt-950/60 px-3 py-2 text-sm text-paper-50 outline-none placeholder:text-paper-300/40 focus:border-amber-300 sm:text-base"
              />
            )}
            <button
              id="join-group"
              type="submit"
              class="w-full rounded-xl bg-amber-300 px-4 py-3 text-sm font-black uppercase tracking-widest text-felt-950 shadow-[0_6px_0_rgb(0_0_0/0.3)] transition-all active:translate-y-0.5 active:shadow-none sm:text-base"
              data-group-id={group.id}
              data-policy={group.join_policy}
              data-public={isPublic ? '1' : '0'}
              data-group-name={group.name}
              data-owner-card={isPublic ? (group.owner_card_id ?? '') : ''}
            >
              Unirme con mi cartón
            </button>
          </form>

          <!-- Replaces the join form when the visitor's card already plays in
               a group: this one (nothing to do) or another (one card, one group). -->
          <div
            id="join-blocked"
            class="mt-5 hidden text-center text-sm/relaxed text-paper-300/85 sm:text-base/relaxed"
          >
            <p id="join-blocked-text"></p>
            <a
              id="join-blocked-link"
              href="/"
              class="mt-2 hidden underline decoration-paper-300/40 underline-offset-2 transition-colors hover:text-paper-50"
            ></a>
          </div>

          <!-- Membership/ownership actions, revealed by the page script:
               leaving is for members, dissolving the room for its owner. -->
          <button
            id="leave-group"
            type="button"
            class="mt-3 hidden w-full rounded-xl border-2 border-paper-50/30 px-4 py-2.5 text-xs font-black uppercase tracking-widest text-paper-50 transition-colors hover:bg-paper-50/10 sm:text-sm"
          >
            Salir de la sala
          </button>
          <button
            id="delete-group"
            type="button"
            class="mt-2 hidden w-full rounded-xl border-2 border-dauber-600/70 px-4 py-2.5 text-xs font-black uppercase tracking-widest text-dauber-600 transition-colors hover:bg-dauber-600/15 sm:text-sm"
          >
            Borrar la sala
          </button>

          <p class="mt-5 text-center text-[0.625rem] font-bold uppercase tracking-wide text-paper-300/60 sm:text-xs">
            Recluta sufridores
          </p>
          <div class="mt-2 flex justify-center gap-3">
            <button
              id="share-whatsapp"
              type="button"
              aria-label="Compartir por WhatsApp"
              class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-paper-50/30 text-paper-50 transition-colors hover:bg-paper-50/10"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
            </button>
            <button
              id="share-x"
              type="button"
              aria-label="Compartir en X"
              class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-paper-50/30 text-paper-50 transition-colors hover:bg-paper-50/10"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </button>
            <button
              id="share-bluesky"
              type="button"
              aria-label="Compartir en Bluesky"
              class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-paper-50/30 text-paper-50 transition-colors hover:bg-paper-50/10"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.299-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/></svg>
            </button>
            <button
              id="share-copy"
              type="button"
              aria-label="Copiar enlace"
              class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-paper-50/30 text-paper-50 transition-colors hover:bg-paper-50/10"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
          </div>
          <p
            id="join-hint"
            class="mt-2 min-h-4 text-center text-[0.6875rem]/snug text-amber-200/90 sm:text-xs/snug"
            aria-live="polite"
          >
          </p>
        </>
      ) : (
        <article class="mt-5 overflow-hidden rounded-2xl border-4 border-ink-900 bg-paper-50 text-ink-900 shadow-[0_18px_40px_-12px_rgb(0_0_0/0.55)]">
          <div class="px-5 py-8 text-center">
            <p class="inline-block -rotate-3 rounded-lg border-4 border-double border-dauber-600 px-4 py-1.5 text-2xl font-black uppercase tracking-[0.25em] text-dauber-600">
              No consta
            </p>
            <p class="mt-5 text-sm/relaxed text-ink-900/80 sm:text-base/relaxed">
              Este grupo no existe. Crea uno desde la página principal y reparte sufrimiento.
            </p>
          </div>
        </article>
      )
    }

    <a
      href="/"
      class="mt-6 rounded-xl border-2 border-paper-50/30 px-4 py-3 text-center text-sm font-black uppercase tracking-widest text-paper-50 transition-colors hover:bg-paper-50/10 sm:text-base"
    >
      Ir a mi cartón
    </a>

    <footer
      class="mt-auto pt-8 text-center text-[0.6875rem]/relaxed text-paper-300/55 sm:text-sm/relaxed"
    >
      <p class="font-semibold">bingo.gruxon.com · Hecho con resignación · 2026</p>
    </footer>
  </main>
</Layout>

<script>
  // Join + share wiring. The visitor's card (and its secret) live in their
  // localStorage; joining sends them same-origin to the join endpoint with a
  // mandatory alias (and the password for protected groups). Private groups
  // reveal their standings only to members, fetched here with that secret.
  import {
    deleteGroup,
    fetchGroupStandings,
    fetchOwnedCard,
    joinGroup,
    kickMember,
    leaveGroup,
    type GroupStandings,
  } from '../../lib/api';
  import { SITUATION_COUNT } from '../../lib/card';
  import { loadAlias, loadCurrentCard, saveAlias, saveCard } from '../../lib/storage';

  const joinForm = document.querySelector<HTMLFormElement>('#join-form');
  const joinButton = document.querySelector<HTMLButtonElement>('#join-group');
  const aliasInput = document.querySelector<HTMLInputElement>('#join-alias');
  const aliasDisplay = document.querySelector<HTMLParagraphElement>('#join-alias-display');
  const aliasLabel = document.querySelector<HTMLElement>('#join-alias-label');
  const aliasEditButton = document.querySelector<HTMLButtonElement>('#join-alias-edit');
  const passwordInput = document.querySelector<HTMLInputElement>('#join-password');
  const blockedBox = document.querySelector<HTMLDivElement>('#join-blocked');
  const blockedText = document.querySelector<HTMLParagraphElement>('#join-blocked-text');
  const blockedLink = document.querySelector<HTMLAnchorElement>('#join-blocked-link');
  const whatsappButton = document.querySelector<HTMLButtonElement>('#share-whatsapp');
  const xButton = document.querySelector<HTMLButtonElement>('#share-x');
  const blueskyButton = document.querySelector<HTMLButtonElement>('#share-bluesky');
  const copyButton = document.querySelector<HTMLButtonElement>('#share-copy');
  const hint = document.querySelector<HTMLParagraphElement>('#join-hint');
  const privateBoard = document.querySelector<HTMLElement>('#private-board');
  const privateNotice = document.querySelector<HTMLParagraphElement>('#private-notice');

  const leaveButton = document.querySelector<HTMLButtonElement>('#leave-group');
  const deleteButton = document.querySelector<HTMLButtonElement>('#delete-group');

  const card = loadCurrentCard();
  const groupId = joinButton?.dataset.groupId ?? '';
  const policy = joinButton?.dataset.policy ?? 'open';
  const isPublic = joinButton?.dataset.public === '1';
  const groupName = joinButton?.dataset.groupName ?? '';
  // Who owns the room: server-rendered for public boards; private boards
  // reveal it through the members-only standings fetch below.
  let ownerCardId: string | null = joinButton?.dataset.ownerCard || null;

  function setHint(message: string): void {
    if (hint) hint.textContent = message;
  }

  // --- Alias ----------------------------------------------------------------
  // The alias is a display label shared with the main page (evbingo.alias).
  // Once set, it shows as text with a change button instead of an input.

  if (aliasInput) aliasInput.value = loadAlias();

  function renderAliasField(): void {
    if (!aliasInput || !aliasDisplay || !aliasLabel) return;
    const alias = loadAlias();
    aliasLabel.textContent = `«${alias}»`;
    aliasInput.classList.toggle('hidden', alias !== '');
    aliasDisplay.classList.toggle('hidden', alias === '');
  }

  aliasEditButton?.addEventListener('click', () => {
    aliasDisplay?.classList.add('hidden');
    aliasInput?.classList.remove('hidden');
    aliasInput?.focus();
  });

  renderAliasField();

  // --- Join state -----------------------------------------------------------
  // One card, one group: a card already playing here has nothing to join, and
  // a card playing elsewhere can't switch (regenerating it is the way out).
  // Members get the way out (salir); the owner also gets the demolition lever.

  function isOwner(): boolean {
    return !!card?.secret && !!ownerCardId && card.id === ownerCardId;
  }

  function renderJoinState(): void {
    if (!joinForm || !blockedBox || !blockedText || !blockedLink) return;
    const memberHere = !!card?.secret && card.groupId === groupId;
    const memberElsewhere = !!card?.groupId && card.groupId !== groupId;
    joinForm.classList.toggle('hidden', memberHere || memberElsewhere);
    blockedBox.classList.toggle('hidden', !memberHere && !memberElsewhere);
    leaveButton?.classList.toggle('hidden', !memberHere);
    deleteButton?.classList.toggle('hidden', !isOwner());
    if (memberHere) {
      blockedText.textContent = 'Tu cartón ya está en esta sala. A sufrir, que para eso has venido.';
      blockedLink.classList.add('hidden');
    } else if (memberElsewhere) {
      blockedText.textContent =
        'Tu cartón ya juega en otra sala. Un cartón, un grupo: regenera el cartón si quieres cambiar.';
      blockedLink.href = `/g/${card!.groupId}`;
      blockedLink.textContent = 'Ver mi sala';
      blockedLink.classList.remove('hidden');
    }
  }

  renderJoinState();

  // Walk out. If the owner leaves, the server hands the office to the most
  // veteran remaining member; an emptied room dissolves on its own.
  leaveButton?.addEventListener('click', async () => {
    if (!card?.secret) return;
    const warning = isOwner()
      ? '¿Salir de la sala? El cargo pasa al miembro más veterano. Tu cartón no se borra.'
      : '¿Salir de la sala? Tu cartón no se borra: sigue jugándose en solitario.';
    if (!confirm(warning)) return;
    const result = await leaveGroup(groupId, card.id, card.secret);
    // 'not_member' = already out (kicked while this page sat open): same end
    // state as a successful leave, so sync and move on instead of retrying.
    if (!result.ok && result.error !== 'not_member') {
      setHint('No se pudo salir. Inténtalo de nuevo.');
      return;
    }
    card.groupId = null;
    saveCard(card);
    location.reload();
  });

  // Demolition, owner-only: every member card is unlinked, none is deleted.
  deleteButton?.addEventListener('click', async () => {
    if (!card?.secret || !isOwner()) return;
    if (!confirm('¿Borrar la sala para todos? Los cartones no se borran: se quedan sin sala.')) {
      return;
    }
    const result = await deleteGroup(groupId, card.id, card.secret);
    // 'not_found' = the room is already gone; that's the goal anyway.
    if (!result.ok && result.error !== 'not_found') {
      setHint('No se pudo borrar la sala. Inténtalo de nuevo.');
      return;
    }
    if (card.groupId === groupId) {
      card.groupId = null;
      saveCard(card);
    }
    location.href = '/';
  });

  // The server rules membership (the admin may have kicked this card, or it
  // joined from another device): refresh quietly and re-render on change.
  async function refreshMembership(): Promise<void> {
    if (!card?.secret) return;
    const owned = await fetchOwnedCard(card.id, card.secret);
    if (!owned || owned.id !== card.id) return;
    const serverGroup = owned.groupId ?? null;
    if (serverGroup !== card.groupId) {
      card.groupId = serverGroup;
      saveCard(card);
      renderJoinState();
    }
  }
  void refreshMembership();

  // --- Moderation (room owner) ------------------------------------------------
  // The owner's card holds the office: every OTHER member's row gets an
  // "echar" button (the owner leaves via "Salir de la sala", not by kicking
  // themselves). Kicking unlinks the card from the room — the card, its marks
  // and its diploma survive; only the membership goes.

  function wireKickButtons(): void {
    if (!card?.secret || !isOwner()) return;
    const ownerCard = card;
    document.querySelectorAll<HTMLElement>('[data-member-card]').forEach((row) => {
      if (row.querySelector('.kick-btn')) return;
      const memberId = row.dataset.memberCard ?? '';
      if (!memberId || memberId === ownerCard.id) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className =
        'kick-btn text-[0.6875rem] font-semibold text-dauber-700 underline decoration-dauber-700/40 underline-offset-2 sm:text-xs';
      button.textContent = 'echar';
      button.addEventListener('click', async () => {
        if (!confirm('¿Echar este cartón de la sala? No se borra: solo deja de jugar en el grupo.')) {
          return;
        }
        const result = await kickMember(groupId, ownerCard.id, ownerCard.secret!, memberId);
        // 'not_member' = the row already walked out on its own; reloading
        // shows the same end state either way.
        if (!result.ok && result.error !== 'not_member') {
          setHint('No se pudo echar. Inténtalo de nuevo.');
          return;
        }
        location.reload();
      });
      row.querySelector('.member-actions')?.prepend(button);
    });
  }

  wireKickButtons();

  // Mark the visitor's own card in the (public, server-rendered) standings.
  if (card) {
    document
      .querySelector(`[data-member-card="${card.id}"] .member-you`)
      ?.classList.remove('hidden');
  }

  // --- Private board: reveal the standings to members only ----------------

  function markedOf(marks: string | null): number {
    if (!marks) return 0;
    return [...marks].filter((digit) => digit !== '0').length;
  }

  function escapeHtml(value: string): string {
    return value.replace(
      /[&<>"]/g,
      (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[char] ?? char,
    );
  }

  function renderPrivateBoard(data: GroupStandings): void {
    if (!privateBoard) return;
    const winnerId = data.winnerCardId;
    const sorted = [...data.members].sort((a, b) => {
      if (a.id === winnerId) return -1;
      if (b.id === winnerId) return 1;
      return markedOf(b.marks) - markedOf(a.marks);
    });

    const rows = sorted
      .map((member) => {
        const you = card && member.id === card.id;
        const name = escapeHtml(member.alias ?? `Cartón nº ${member.id}`);
        const trophy = member.id === winnerId ? '🏆 ' : '';
        const score = member.completedAt
          ? 'BINGO'
          : `${markedOf(member.marks)}/${SITUATION_COUNT}`;
        return `<li class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm sm:text-base" data-member-card="${member.id}">
          <span class="min-w-0 truncate">${trophy}<strong>${name}</strong>${you ? '<span class="text-ink-900/55"> (tú)</span>' : ''}</span>
          <span class="member-actions flex shrink-0 items-center gap-2">
            <a href="/c/${member.id}" class="text-[0.6875rem] underline decoration-ink-900/30 underline-offset-2 sm:text-xs">ver</a>
            <span class="font-mono font-bold">${score}</span>
          </span>
        </li>`;
      })
      .join('');

    privateNotice?.remove();
    const list = document.createElement('ul');
    list.className = 'divide-y divide-ink-900/15';
    list.innerHTML =
      rows ||
      '<li class="px-4 py-6 text-center text-sm text-ink-900/70 sm:text-base">Todavía no hay cartones en la sala.</li>';
    privateBoard.append(list);
    // The admin gets their "echar" buttons on the freshly rendered rows too.
    wireKickButtons();
  }

  async function loadPrivateBoard(): Promise<void> {
    if (isPublic || !privateBoard || !card?.secret) return;
    const data = await fetchGroupStandings(groupId, card.id, card.secret);
    if (!data) return;
    // Private boards learn the owner here (it never renders server-side):
    // refresh the moderation UI before drawing the rows it decorates.
    ownerCardId = data.ownerCardId ?? null;
    renderJoinState();
    renderPrivateBoard(data);
  }
  void loadPrivateBoard();

  // --- Join ---------------------------------------------------------------

  joinForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const alias = aliasInput?.value.trim() ?? '';
    if (!card || !card.secret) {
      setHint('No tienes un cartón registrado. Ve a la página principal y vuelve.');
      return;
    }
    if (card.completedAt) {
      setHint('Tu cartón ya está completo: entrar ahora sería hacer trampas.');
      return;
    }
    if (!alias) {
      setHint('Necesitas un alias para entrar en el grupo.');
      return;
    }
    const password = passwordInput?.value ?? '';
    if (policy === 'password' && !password) {
      setHint('Este grupo pide contraseña.');
      return;
    }

    setHint('Entrando…');
    saveAlias(alias);
    const result = await joinGroup(groupId, card.id, card.secret, alias, password);
    if (result.ok) {
      card.groupId = groupId;
      saveCard(card);
      location.reload();
      return;
    }
    setHint(
      result.error === 'bad_password'
        ? 'Contraseña incorrecta.'
        : result.error === 'already_grouped'
          ? 'Tu cartón ya juega en otra sala. Regenera el cartón para cambiar.'
          : result.error === 'cannot_join'
            ? 'No se pudo entrar: revisa que el cartón siga en juego.'
            : 'No se pudo entrar. Inténtalo de nuevo.',
    );
  });

  // --- Share --------------------------------------------------------------

  function shareText(platform: 'bluesky' | 'default' = 'default'): string {
    const mention = platform === 'bluesky' ? '@gtrabanco.bsky.social' : '@GabrielTrabanco';
    const joinLine =
      policy === 'password'
        ? 'Hace falta la contraseña para entrar (te la paso aparte).'
        : 'Cualquiera con el enlace puede unirse.';
    const visLine = isPublic
      ? 'El estado y los alias de los participantes son públicos.'
      : 'El estado solo lo ven los participantes.';
    return `Únete a mi grupo de bingo «${groupName}» en El Bingo del Cargador (vía ${mention}). ${joinLine} ${visLine} #BingoDelCargador #EVEspaña #Tesla ${location.href}`;
  }

  whatsappButton?.addEventListener('click', () => {
    window.open(`https://wa.me/?text=${encodeURIComponent(shareText())}`, '_blank', 'noopener');
  });

  xButton?.addEventListener('click', () => {
    window.open(
      `https://x.com/intent/post?text=${encodeURIComponent(shareText())}`,
      '_blank',
      'noopener',
    );
  });

  blueskyButton?.addEventListener('click', () => {
    window.open(
      `https://bsky.app/intent/compose?text=${encodeURIComponent(shareText('bluesky'))}`,
      '_blank',
      'noopener',
    );
  });

  copyButton?.addEventListener('click', async () => {
    if (navigator.share) {
      try {
        await navigator.share({ title: `Grupo de bingo «${groupName}»`, text: shareText() });
        return;
      } catch {
        // Sheet dismissed: fall through to the clipboard.
      }
    }
    try {
      await navigator.clipboard.writeText(shareText());
      setHint('Texto copiado. Reparte el enlace.');
    } catch {
      setHint(location.href);
    }
  });
</script>
