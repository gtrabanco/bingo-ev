---
// Bingo dialog with the certificate stub (canvas preview + PNG download).
// All behavior is wired from the page script in index.astro.
---

<dialog
  id="bingo-dialog"
  aria-labelledby="bingo-dialog-title"
  class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-2xl border-4 border-ink-900 bg-paper-50 p-0 text-ink-900 shadow-2xl backdrop:bg-felt-950/80"
>
  <div class="p-5 sm:p-6">
    <p class="text-xs font-bold uppercase tracking-[0.3em] text-dauber-700">Cartón completo</p>
    <h2 id="bingo-dialog-title" class="mt-1 text-4xl font-black uppercase tracking-tight">
      ¡Bingo!
    </h2>
    <p class="mt-2 text-sm/relaxed text-ink-900/70">
      Todas las casillas, y dentro del plazo. Una trayectoria impecable hacia el desastre. Pon tu
      nombre y llévate el diploma.
    </p>

    <label
      class="mt-5 block text-xs font-semibold uppercase tracking-wide text-ink-900/60"
      for="cert-nick"
    >
      Tu nombre o apodo
    </label>
    <input
      id="cert-nick"
      type="text"
      maxlength="32"
      placeholder="P. ej.: Conductora resiliente"
      autocomplete="nickname"
      class="mt-1.5 w-full rounded-lg border-2 border-ink-900 bg-white px-3 py-2 text-base outline-none focus:border-dauber-600"
    />

    <canvas
      id="cert-canvas"
      width="1200"
      height="900"
      aria-label="Vista previa del certificado"
      class="mt-4 h-auto w-full rounded-md border-2 border-paper-300"></canvas>

    <div
      class="mt-3 flex items-center gap-2 rounded-lg border-2 border-paper-300 bg-paper-100 px-3 py-2"
    >
      <p
        id="cert-link"
        class="min-w-0 flex-1 truncate font-mono text-[0.6875rem] text-ink-900/70 sm:text-xs"
      >
      </p>
      <button
        id="cert-copy"
        type="button"
        class="shrink-0 rounded-md border-2 border-ink-900 px-2.5 py-1 text-[0.6875rem] font-bold uppercase tracking-wide transition-colors active:bg-paper-300 sm:text-xs"
      >
        Copiar
      </button>
    </div>

    <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-ink-900/60">
      Presume de desgracia
    </p>
    <div class="mt-2 flex justify-center gap-3">
      <button
        id="share-whatsapp"
        type="button"
        aria-label="Compartir por WhatsApp"
        class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-ink-900 transition-colors active:bg-paper-100"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
      </button>
      <button
        id="share-x"
        type="button"
        aria-label="Compartir en X"
        class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-ink-900 transition-colors active:bg-paper-100"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </button>
      <button
        id="share-bluesky"
        type="button"
        aria-label="Compartir en Bluesky"
        class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-ink-900 transition-colors active:bg-paper-100"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.299-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/></svg>
      </button>
      <button
        id="share-instagram"
        type="button"
        aria-label="Compartir en Instagram"
        class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-ink-900 transition-colors active:bg-paper-100"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
      </button>
      <button
        id="share-youtube"
        type="button"
        aria-label="Compartir en YouTube"
        class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-ink-900 transition-colors active:bg-paper-100"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
      </button>
    </div>
    <p
      id="share-hint"
      class="mt-2 min-h-4 text-[0.6875rem]/snug text-ink-900/60 sm:text-xs/snug"
      aria-live="polite"
    >
    </p>

    <div class="mt-4 flex gap-2">
      <button
        id="cert-download"
        type="button"
        class="flex-1 rounded-xl bg-dauber-600 px-4 py-3 text-sm font-black uppercase tracking-widest text-paper-50 transition-colors active:bg-dauber-700"
      >
        Descargar PNG
      </button>
      <button
        id="cert-close"
        type="button"
        class="rounded-xl border-2 border-ink-900 px-4 py-3 text-sm font-bold uppercase tracking-widest transition-colors active:bg-paper-100"
      >
        Cerrar
      </button>
    </div>
  </div>
</dialog>
