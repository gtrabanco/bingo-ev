---
// Static frame of the cartón. Cells are injected client-side because every
// visitor gets a different random card; see the page script in index.astro.
//
// The grid behaves like a rotated physical card: the canonical layout is
// landscape (3 rows x 4 cols, línea = row) and portrait screens render the
// transpose (3 cols x 4 rows) by filling the same DOM order column-first
// (grid-flow-col), so líneas run vertically there. Win logic never changes.
---

<article
  id="bingo-card"
  class="relative w-full overflow-hidden rounded-2xl border-4 border-ink-900 bg-paper-50 text-ink-900 shadow-[0_18px_40px_-12px_rgb(0_0_0/0.55)]"
>
  <header
    class="flex items-baseline justify-between gap-3 border-b-4 border-ink-900 bg-dauber-600 px-3.5 py-2 text-paper-50"
  >
    <p class="text-lg font-black uppercase tracking-[0.35em] sm:text-xl">Bingo</p>
    <p class="shrink-0 font-mono text-[0.625rem] tracking-wider uppercase sm:text-xs">
      Cartón nº <span id="card-serial">········</span>
    </p>
  </header>

  <div
    id="bingo-grid"
    class="grid grid-flow-col grid-cols-3 grid-rows-4 gap-px bg-ink-900 landscape:grid-flow-row landscape:grid-cols-4 landscape:grid-rows-3"
  >
  </div>

  <footer
    class="flex items-center justify-between gap-2 border-t-4 border-ink-900 bg-paper-100 px-3.5 py-1.5 text-[0.5625rem] font-semibold uppercase tracking-[0.14em] text-ink-900/60 sm:text-[0.6875rem]"
  >
    <span>Serie: vía pública</span>
    <span class="shrink-0">Caduca: <span id="card-expiry">—</span></span>
  </footer>

  <!-- Rubber stamp shown when the card expires without completing -->
  <div id="expired-stamp" class="expired-stamp hidden" aria-hidden="true">Caducado</div>
</article>
