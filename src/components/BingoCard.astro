---
// Static frame of the cartón. Cells are injected client-side (index.astro).
// Layout note: canonical card is landscape (3×4, línea = row); portrait renders
// the transpose via grid-flow-col (see card.ts / wins.ts — win logic unchanged).
import CardFrame from './CardFrame.astro';
---

<CardFrame id="bingo-card" class="relative w-full">
  <p slot="header-left" class="font-mono text-[0.625rem] tracking-wider uppercase sm:text-xs">
    Cartón nº <span id="card-serial" class="font-bold">········</span>
  </p>
  <p slot="header-right" class="shrink-0 text-[0.625rem] font-bold uppercase tracking-[0.2em] text-paper-50 sm:text-xs">
    Vía pública
  </p>
  <div
    id="bingo-grid"
    class="grid grid-flow-col grid-cols-3 grid-rows-4 gap-px bg-ink-900 landscape:grid-flow-row landscape:grid-cols-4 landscape:grid-rows-3"
  ></div>
  <div id="expired-stamp" class="expired-stamp hidden" aria-hidden="true">Caducado</div>
  <span slot="footer">Sin validez legal</span>
  <span slot="footer" class="shrink-0">Caduca: <span id="card-expiry">—</span></span>
</CardFrame>
