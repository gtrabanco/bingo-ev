---
interface Props {
  as?: 'article' | 'section';
  id?: string;
  class?: string;
  footerCenter?: boolean;
}
const { as: El = 'article', id, class: className, footerCenter = false } = Astro.props;
const hasHeader = Astro.slots.has('header-left') || Astro.slots.has('header-right');
const hasFooter = Astro.slots.has('footer');
---

<El
  id={id}
  class:list={[
    'overflow-hidden rounded-2xl border-4 border-ink-900 bg-paper-50 text-ink-900 shadow-[0_18px_40px_-12px_rgb(0_0_0/0.55)]',
    className,
  ]}
>
  {hasHeader && (
    <header class="flex items-center justify-between gap-3 border-b-4 border-ink-900 bg-dauber-600 px-3.5 py-2.5 text-paper-50">
      <slot name="header-left" />
      <slot name="header-right" />
    </header>
  )}
  <slot />
  {hasFooter && (
    <footer
      class:list={[
        'border-t-4 border-ink-900 bg-paper-100 px-3.5 py-1.5 text-[0.5625rem] font-semibold uppercase tracking-[0.14em] text-ink-900/70 sm:text-[0.6875rem]',
        footerCenter ? 'text-center' : 'flex items-center justify-between gap-2',
      ]}
    >
      <slot name="footer" />
    </footer>
  )}
</El>
