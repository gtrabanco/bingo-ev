---
// Base HTML shell: meta tags, favicon and global styles.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageType?: string;
  noIndex?: boolean;
}

const {
  title = 'El Bingo del Cargador',
  description = 'El juego de azar favorito de quien conduce un eléctrico por España. Marca las desgracias del cargador público que hayas vivido y canta bingo.',
  ogImage = '/og/home.svg',
  ogImageType = 'image/svg+xml',
  noIndex = false,
} = Astro.props;

const canonicalUrl = `https://bingo.gruxon.com${Astro.url.pathname}`;
const ogImageUrl = new URL(ogImage, 'https://bingo.gruxon.com').href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b3d2e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={ogImageType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="keywords" content="bingo, juego online, cargador eléctrico, EV, desgracias, españa, gratuito, cartón, recarga" />
    <meta name="author" content="Gabriel Trabanco" />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{title}</title>
    {import.meta.env.PROD && <script defer src="https://gabi.pw/script.js" data-website-id="15b24371-a7c1-4039-a2ae-6a43213cc8ff"></script>}
  </head>
  <body class="min-h-dvh bg-felt-900 text-paper-50 antialiased">
    <slot />

    <script type="application/ld+json">
    {{
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "El Bingo del Cargador",
      "description": "Juego de bingo online sobre las desgracias típicas de cargar un coche eléctrico en España",
      "url": "https://bingo.gruxon.com",
      "applicationCategory": "Game",
      "gamePlatform": "Web",
      "operatingSystem": "Web",
      "inLanguage": "es-ES",
      "creator": {{
        "@type": "Person",
        "name": "Gabriel Trabanco",
        "url": "https://gtrabanco.com"
      }},
      "offers": {{
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }},
      "aggregateRating": {{
        "@type": "AggregateRating",
        "ratingValue": "4.5",
        "ratingCount": "1"
      }}
    }}
    </script>
  </body>
</html>
