{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "disabled": false,
      "directTools": true
    },
    "Astro docs": {
      "type": "http",
      "url": "https://mcp.docs.astro.build/mcp",
      "directTools": true
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ],
      "lifecycle": "lazy",
      "directTools": true
    }
  }
}
